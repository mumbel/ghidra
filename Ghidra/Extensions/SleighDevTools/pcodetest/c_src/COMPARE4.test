TEST i4_conditionGT_Main()
{
	extern u1 i4_conditionGT(i4 lhs, i4 rhs);
	extern u1 i4_conditionGTUnused(i4 val, i4 lhs, i4 rhs);
	extern u1 i4_conditionGTZero(i4 val);
	extern u1 i4_conditionGTOne(i4 val);

	ASSERTU1(i4_conditionGT(0, 0), 0);
	ASSERTU1(i4_conditionGT(0, 1), 0);
	ASSERTU1(i4_conditionGT(0, I4_MAX), 0);
	ASSERTU1(i4_conditionGT(0, I4_MIN), 1);
	ASSERTU1(i4_conditionGT(1, 0), 1);
	ASSERTU1(i4_conditionGT(1, 1), 0);
	ASSERTU1(i4_conditionGT(1, I4_MAX), 0);
	ASSERTU1(i4_conditionGT(1, I4_MIN), 1);
	ASSERTU1(i4_conditionGT(I4_MAX, 0), 1);
	ASSERTU1(i4_conditionGT(I4_MAX, 1), 1);
	ASSERTU1(i4_conditionGT(I4_MAX, I4_MAX), 0);
	ASSERTU1(i4_conditionGT(I4_MAX, I4_MIN), 1);
	ASSERTU1(i4_conditionGT(I4_MIN, 0), 0);
	ASSERTU1(i4_conditionGT(I4_MIN, 1), 0);
	ASSERTU1(i4_conditionGT(I4_MIN, I4_MAX), 0);
	ASSERTU1(i4_conditionGT(I4_MIN, I4_MIN), 0);

	ASSERTU1(i4_conditionGTUnused(0, 0, 0), 0);
	ASSERTU1(i4_conditionGTUnused(0, 0, 1), 0);
	ASSERTU1(i4_conditionGTUnused(0, 0, I4_MAX), 0);
	ASSERTU1(i4_conditionGTUnused(0, 0, I4_MIN), 1);
	ASSERTU1(i4_conditionGTUnused(0, 1, 0), 1);
	ASSERTU1(i4_conditionGTUnused(0, 1, 1), 0);
	ASSERTU1(i4_conditionGTUnused(0, 1, I4_MAX), 0);
	ASSERTU1(i4_conditionGTUnused(0, 1, I4_MIN), 1);
	ASSERTU1(i4_conditionGTUnused(0, I4_MAX, 0), 1);
	ASSERTU1(i4_conditionGTUnused(0, I4_MAX, 1), 1);
	ASSERTU1(i4_conditionGTUnused(0, I4_MAX, I4_MAX), 0);
	ASSERTU1(i4_conditionGTUnused(0, I4_MAX, I4_MIN), 1);
	ASSERTU1(i4_conditionGTUnused(0, I4_MIN, 0), 0);
	ASSERTU1(i4_conditionGTUnused(0, I4_MIN, 1), 0);
	ASSERTU1(i4_conditionGTUnused(0, I4_MIN, I4_MAX), 0);
	ASSERTU1(i4_conditionGTUnused(0, I4_MIN, I4_MIN), 0);

	ASSERTU1(i4_conditionGTZero(0), 0);
	ASSERTU1(i4_conditionGTZero(1), 1);
	ASSERTU1(i4_conditionGTZero(I4_MAX), 1);
	ASSERTU1(i4_conditionGTZero(I4_MIN), 0);

	ASSERTU1(i4_conditionGTOne(0), 0);
	ASSERTU1(i4_conditionGTOne(1), 0);
	ASSERTU1(i4_conditionGTOne(I4_MAX), 1);
	ASSERTU1(i4_conditionGTOne(I4_MIN), 0);
}

TEST i4_conditionGE_Main()
{
	extern u1 i4_conditionGE(i4 lhs, i4 rhs);
	extern u1 i4_conditionGEUnused(i4 val, i4 lhs, i4 rhs);
	extern u1 i4_conditionGEZero(i4 val);
	extern u1 i4_conditionGEOne(i4 val);

	ASSERTU1(i4_conditionGE(0, 0), 1);
	ASSERTU1(i4_conditionGE(0, 1), 0);
	ASSERTU1(i4_conditionGE(0, I4_MAX), 0);
	ASSERTU1(i4_conditionGE(0, I4_MIN), 1);
	ASSERTU1(i4_conditionGE(1, 0), 1);
	ASSERTU1(i4_conditionGE(1, 1), 1);
	ASSERTU1(i4_conditionGE(1, I4_MAX), 0);
	ASSERTU1(i4_conditionGE(1, I4_MIN), 1);
	ASSERTU1(i4_conditionGE(I4_MAX, 0), 1);
	ASSERTU1(i4_conditionGE(I4_MAX, 1), 1);
	ASSERTU1(i4_conditionGE(I4_MAX, I4_MAX), 1);
	ASSERTU1(i4_conditionGE(I4_MAX, I4_MIN), 1);
	ASSERTU1(i4_conditionGE(I4_MIN, 0), 0);
	ASSERTU1(i4_conditionGE(I4_MIN, 1), 0);
	ASSERTU1(i4_conditionGE(I4_MIN, I4_MAX), 0);
	ASSERTU1(i4_conditionGE(I4_MIN, I4_MIN), 1);

	ASSERTU1(i4_conditionGEUnused(0, 0, 0), 1);
	ASSERTU1(i4_conditionGEUnused(0, 0, 1), 0);
	ASSERTU1(i4_conditionGEUnused(0, 0, I4_MAX), 0);
	ASSERTU1(i4_conditionGEUnused(0, 0, I4_MIN), 1);
	ASSERTU1(i4_conditionGEUnused(0, 1, 0), 1);
	ASSERTU1(i4_conditionGEUnused(0, 1, 1), 1);
	ASSERTU1(i4_conditionGEUnused(0, 1, I4_MAX), 0);
	ASSERTU1(i4_conditionGEUnused(0, 1, I4_MIN), 1);
	ASSERTU1(i4_conditionGEUnused(0, I4_MAX, 0), 1);
	ASSERTU1(i4_conditionGEUnused(0, I4_MAX, 1), 1);
	ASSERTU1(i4_conditionGEUnused(0, I4_MAX, I4_MAX), 1);
	ASSERTU1(i4_conditionGEUnused(0, I4_MAX, I4_MIN), 1);
	ASSERTU1(i4_conditionGEUnused(0, I4_MIN, 0), 0);
	ASSERTU1(i4_conditionGEUnused(0, I4_MIN, 1), 0);
	ASSERTU1(i4_conditionGEUnused(0, I4_MIN, I4_MAX), 0);
	ASSERTU1(i4_conditionGEUnused(0, I4_MIN, I4_MIN), 1);

	ASSERTU1(i4_conditionGEZero(0), 1);
	ASSERTU1(i4_conditionGEZero(1), 1);
	ASSERTU1(i4_conditionGEZero(I4_MAX), 1);
	ASSERTU1(i4_conditionGEZero(I4_MIN), 0);

	ASSERTU1(i4_conditionGEOne(0), 0);
	ASSERTU1(i4_conditionGEOne(1), 1);
	ASSERTU1(i4_conditionGEOne(I4_MAX), 1);
	ASSERTU1(i4_conditionGEOne(I4_MIN), 0);
}

TEST i4_conditionEQ_Main()
{
	extern u1 i4_conditionEQ(i4 lhs, i4 rhs);
	extern u1 i4_conditionEQUnused(i4 val, i4 lhs, i4 rhs);
	extern u1 i4_conditionEQZero(i4 val);
	extern u1 i4_conditionEQOne(i4 val);

	ASSERTU1(i4_conditionEQ(0, 0), 1);
	ASSERTU1(i4_conditionEQ(0, 1), 0);
	ASSERTU1(i4_conditionEQ(0, I4_MAX), 0);
	ASSERTU1(i4_conditionEQ(0, I4_MIN), 0);
	ASSERTU1(i4_conditionEQ(1, 0), 0);
	ASSERTU1(i4_conditionEQ(1, 1), 1);
	ASSERTU1(i4_conditionEQ(1, I4_MAX), 0);
	ASSERTU1(i4_conditionEQ(1, I4_MIN), 0);
	ASSERTU1(i4_conditionEQ(I4_MAX, 0), 0);
	ASSERTU1(i4_conditionEQ(I4_MAX, 1), 0);
	ASSERTU1(i4_conditionEQ(I4_MAX, I4_MAX), 1);
	ASSERTU1(i4_conditionEQ(I4_MAX, I4_MIN), 0);
	ASSERTU1(i4_conditionEQ(I4_MIN, 0), 0);
	ASSERTU1(i4_conditionEQ(I4_MIN, 1), 0);
	ASSERTU1(i4_conditionEQ(I4_MIN, I4_MAX), 0);
	ASSERTU1(i4_conditionEQ(I4_MIN, I4_MIN), 1);

	ASSERTU1(i4_conditionEQUnused(0, 0, 0), 1);
	ASSERTU1(i4_conditionEQUnused(0, 0, 1), 0);
	ASSERTU1(i4_conditionEQUnused(0, 0, I4_MAX), 0);
	ASSERTU1(i4_conditionEQUnused(0, 0, I4_MIN), 0);
	ASSERTU1(i4_conditionEQUnused(0, 1, 0), 0);
	ASSERTU1(i4_conditionEQUnused(0, 1, 1), 1);
	ASSERTU1(i4_conditionEQUnused(0, 1, I4_MAX), 0);
	ASSERTU1(i4_conditionEQUnused(0, 1, I4_MIN), 0);
	ASSERTU1(i4_conditionEQUnused(0, I4_MAX, 0), 0);
	ASSERTU1(i4_conditionEQUnused(0, I4_MAX, 1), 0);
	ASSERTU1(i4_conditionEQUnused(0, I4_MAX, I4_MAX), 1);
	ASSERTU1(i4_conditionEQUnused(0, I4_MAX, I4_MIN), 0);
	ASSERTU1(i4_conditionEQUnused(0, I4_MIN, 0), 0);
	ASSERTU1(i4_conditionEQUnused(0, I4_MIN, 1), 0);
	ASSERTU1(i4_conditionEQUnused(0, I4_MIN, I4_MAX), 0);
	ASSERTU1(i4_conditionEQUnused(0, I4_MIN, I4_MIN), 1);

	ASSERTU1(i4_conditionEQZero(0), 1);
	ASSERTU1(i4_conditionEQZero(1), 0);
	ASSERTU1(i4_conditionEQZero(I4_MAX), 0);
	ASSERTU1(i4_conditionEQZero(I4_MIN), 0);

	ASSERTU1(i4_conditionEQOne(0), 0);
	ASSERTU1(i4_conditionEQOne(1), 1);
	ASSERTU1(i4_conditionEQOne(I4_MAX), 0);
	ASSERTU1(i4_conditionEQOne(I4_MIN), 0);
}

