#include "pcode_test.h"

TEST u4_compareLogic_Main()
{
	extern u4 u4_compareLogic(u4 lhs, u4 rhs);
	ASSERTU4(u4_compareLogic(0x1, 0x1), 66);
	ASSERTU4(u4_compareLogic(0x1, 0x2), 38);
	ASSERTU4(u4_compareLogic(0x2, 0x1), 42);
}

TEST i4_compareLogic_Main()
{
	extern i4 i4_compareLogic(i4 lhs, i4 rhs);
	ASSERTI4(i4_compareLogic(0x1, 0x1), 66);
	ASSERTI4(i4_compareLogic(0x1, 0x2), 38);
	ASSERTI4(i4_compareLogic(0x2, 0x1), 42);
	ASSERTI4(i4_compareLogic(-0x1, -0x1), 65);
	ASSERTI4(i4_compareLogic(-0x1, -0x2), 41);
	ASSERTI4(i4_compareLogic(-0x2, -0x1), 37);
}

TEST u4_conditionGT_Main()
{
	extern u1 u4_conditionGT(u4 lhs, u4 rhs);
	extern u1 u4_conditionGTUnused(u4 val, u4 lhs, u4 rhs);
	extern u1 u4_conditionGTZero(u4 val);
	extern u1 u4_conditionGTOne(u4 val);

	ASSERTU1(u4_conditionGT(0, 0), 0);
	ASSERTU1(u4_conditionGT(0, 1), 0);
	ASSERTU1(u4_conditionGT(0, U4_MAX), 0);
	ASSERTU1(u4_conditionGT(1, 0), 1);
	ASSERTU1(u4_conditionGT(1, 1), 0);
	ASSERTU1(u4_conditionGT(1, U4_MAX), 0);
	ASSERTU1(u4_conditionGT(U4_MAX, 0), 1);
	ASSERTU1(u4_conditionGT(U4_MAX, 1), 1);
	ASSERTU1(u4_conditionGT(U4_MAX, U4_MAX), 0);

	ASSERTU1(u4_conditionGTUnused(0, 0, 0), 0);
	ASSERTU1(u4_conditionGTUnused(0, 0, 1), 0);
	ASSERTU1(u4_conditionGTUnused(0, 0, U4_MAX), 0);
	ASSERTU1(u4_conditionGTUnused(0, 1, 0), 1);
	ASSERTU1(u4_conditionGTUnused(0, 1, 1), 0);
	ASSERTU1(u4_conditionGTUnused(0, 1, U4_MAX), 0);
	ASSERTU1(u4_conditionGTUnused(0, U4_MAX, 0), 1);
	ASSERTU1(u4_conditionGTUnused(0, U4_MAX, 1), 1);
	ASSERTU1(u4_conditionGTUnused(0, U4_MAX, U4_MAX), 0);

	ASSERTU1(u4_conditionGTZero(0), 0);
	ASSERTU1(u4_conditionGTZero(1), 1);
	ASSERTU1(u4_conditionGTZero(U4_MAX), 1);

	ASSERTU1(u4_conditionGTOne(0), 0);
	ASSERTU1(u4_conditionGTOne(1), 0);
	ASSERTU1(u4_conditionGTOne(U4_MAX), 1);
}

