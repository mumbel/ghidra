	ASSERTU1(i4_conditionLEUnused(0, I4_MAX, I4_MIN), 0);
	ASSERTU1(i4_conditionLEUnused(0, I4_MIN, 0), 1);
	ASSERTU1(i4_conditionLEUnused(0, I4_MIN, 1), 1);
	ASSERTU1(i4_conditionLEUnused(0, I4_MIN, I4_MAX), 1);
	ASSERTU1(i4_conditionLEUnused(0, I4_MIN, I4_MIN), 1);

	ASSERTU1(i4_conditionLEZero(0), 1);
