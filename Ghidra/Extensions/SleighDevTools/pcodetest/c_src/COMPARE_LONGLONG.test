	ASSERTU1(u8_conditionNEOne(U8_MAX), 1);
}

TEST i8_conditionGT_Main()
{
	extern u1 i8_conditionGT(i8 lhs, i8 rhs);
	extern u1 i8_conditionGTUnused(i8 val, i8 lhs, i8 rhs);
	extern u1 i8_conditionGTZero(i8 val);
	extern u1 i8_conditionGTOne(i8 val);

	ASSERTU1(i8_conditionGT(0, 0), 0);
	ASSERTU1(i8_conditionGT(0, 1), 0);
	ASSERTU1(i8_conditionGT(0, I8_MAX), 0);
	ASSERTU1(i8_conditionGT(0, I8_MIN), 1);
	ASSERTU1(i8_conditionGT(1, 0), 1);
	ASSERTU1(i8_conditionGT(1, 1), 0);
	ASSERTU1(i8_conditionGT(1, I8_MAX), 0);
	ASSERTU1(i8_conditionGT(1, I8_MIN), 1);
	ASSERTU1(i8_conditionGT(I8_MAX, 0), 1);
	ASSERTU1(i8_conditionGT(I8_MAX, 1), 1);
	ASSERTU1(i8_conditionGT(I8_MAX, I8_MAX), 0);
	ASSERTU1(i8_conditionGT(I8_MAX, I8_MIN), 1);
	ASSERTU1(i8_conditionGT(I8_MIN, 0), 0);
	ASSERTU1(i8_conditionGT(I8_MIN, 1), 0);
	ASSERTU1(i8_conditionGT(I8_MIN, I8_MAX), 0);
	ASSERTU1(i8_conditionGT(I8_MIN, I8_MIN), 0);

	ASSERTU1(i8_conditionGTUnused(0, 0, 0), 0);
	ASSERTU1(i8_conditionGTUnused(0, 0, 1), 0);
	ASSERTU1(i8_conditionGTUnused(0, 0, I8_MAX), 0);
	ASSERTU1(i8_conditionGTUnused(0, 0, I8_MIN), 1);
	ASSERTU1(i8_conditionGTUnused(0, 1, 0), 1);
	ASSERTU1(i8_conditionGTUnused(0, 1, 1), 0);
	ASSERTU1(i8_conditionGTUnused(0, 1, I8_MAX), 0);
	ASSERTU1(i8_conditionGTUnused(0, 1, I8_MIN), 1);
	ASSERTU1(i8_conditionGTUnused(0, I8_MAX, 0), 1);
	ASSERTU1(i8_conditionGTUnused(0, I8_MAX, 1), 1);
	ASSERTU1(i8_conditionGTUnused(0, I8_MAX, I8_MAX), 0);
	ASSERTU1(i8_conditionGTUnused(0, I8_MAX, I8_MIN), 1);
	ASSERTU1(i8_conditionGTUnused(0, I8_MIN, 0), 0);
	ASSERTU1(i8_conditionGTUnused(0, I8_MIN, 1), 0);
	ASSERTU1(i8_conditionGTUnused(0, I8_MIN, I8_MAX), 0);
	ASSERTU1(i8_conditionGTUnused(0, I8_MIN, I8_MIN), 0);

	ASSERTU1(i8_conditionGTZero(0), 0);
	ASSERTU1(i8_conditionGTZero(1), 1);
	ASSERTU1(i8_conditionGTZero(I8_MAX), 1);
	ASSERTU1(i8_conditionGTZero(I8_MIN), 0);

	ASSERTU1(i8_conditionGTOne(0), 0);
	ASSERTU1(i8_conditionGTOne(1), 0);
	ASSERTU1(i8_conditionGTOne(I8_MAX), 1);
	ASSERTU1(i8_conditionGTOne(I8_MIN), 0);
}

TEST i8_conditionGE_Main()
{
	extern u1 i8_conditionGE(i8 lhs, i8 rhs);
	extern u1 i8_conditionGEUnused(i8 val, i8 lhs, i8 rhs);
	extern u1 i8_conditionGEZero(i8 val);
	extern u1 i8_conditionGEOne(i8 val);

	ASSERTU1(i8_conditionGE(0, 0), 1);
	ASSERTU1(i8_conditionGE(0, 1), 0);
	ASSERTU1(i8_conditionGE(0, I8_MAX), 0);
	ASSERTU1(i8_conditionGE(0, I8_MIN), 1);
	ASSERTU1(i8_conditionGE(1, 0), 1);
	ASSERTU1(i8_conditionGE(1, 1), 1);
	ASSERTU1(i8_conditionGE(1, I8_MAX), 0);
	ASSERTU1(i8_conditionGE(1, I8_MIN), 1);
	ASSERTU1(i8_conditionGE(I8_MAX, 0), 1);
	ASSERTU1(i8_conditionGE(I8_MAX, 1), 1);
	ASSERTU1(i8_conditionGE(I8_MAX, I8_MAX), 1);
	ASSERTU1(i8_conditionGE(I8_MAX, I8_MIN), 1);
	ASSERTU1(i8_conditionGE(I8_MIN, 0), 0);
	ASSERTU1(i8_conditionGE(I8_MIN, 1), 0);
	ASSERTU1(i8_conditionGE(I8_MIN, I8_MAX), 0);
	ASSERTU1(i8_conditionGE(I8_MIN, I8_MIN), 1);

	ASSERTU1(i8_conditionGEUnused(0, 0, 0), 1);
	ASSERTU1(i8_conditionGEUnused(0, 0, 1), 0);
	ASSERTU1(i8_conditionGEUnused(0, 0, I8_MAX), 0);
	ASSERTU1(i8_conditionGEUnused(0, 0, I8_MIN), 1);
	ASSERTU1(i8_conditionGEUnused(0, 1, 0), 1);
	ASSERTU1(i8_conditionGEUnused(0, 1, 1), 1);
	ASSERTU1(i8_conditionGEUnused(0, 1, I8_MAX), 0);
	ASSERTU1(i8_conditionGEUnused(0, 1, I8_MIN), 1);
	ASSERTU1(i8_conditionGEUnused(0, I8_MAX, 0), 1);
	ASSERTU1(i8_conditionGEUnused(0, I8_MAX, 1), 1);
	ASSERTU1(i8_conditionGEUnused(0, I8_MAX, I8_MAX), 1);
	ASSERTU1(i8_conditionGEUnused(0, I8_MAX, I8_MIN), 1);
	ASSERTU1(i8_conditionGEUnused(0, I8_MIN, 0), 0);
	ASSERTU1(i8_conditionGEUnused(0, I8_MIN, 1), 0);
	ASSERTU1(i8_conditionGEUnused(0, I8_MIN, I8_MAX), 0);
	ASSERTU1(i8_conditionGEUnused(0, I8_MIN, I8_MIN), 1);

	ASSERTU1(i8_conditionGEZero(0), 1);
	ASSERTU1(i8_conditionGEZero(1), 1);
	ASSERTU1(i8_conditionGEZero(I8_MAX), 1);
	ASSERTU1(i8_conditionGEZero(I8_MIN), 0);

	ASSERTU1(i8_conditionGEOne(0), 0);
	ASSERTU1(i8_conditionGEOne(1), 1);
	ASSERTU1(i8_conditionGEOne(I8_MAX), 1);
	ASSERTU1(i8_conditionGEOne(I8_MIN), 0);
}

TEST i8_conditionEQ_Main()
{
	extern u1 i8_conditionEQ(i8 lhs, i8 rhs);
	extern u1 i8_conditionEQUnused(i8 val, i8 lhs, i8 rhs);
	extern u1 i8_conditionEQZero(i8 val);
	extern u1 i8_conditionEQOne(i8 val);

	ASSERTU1(i8_conditionEQ(0, 0), 1);
	ASSERTU1(i8_conditionEQ(0, 1), 0);
	ASSERTU1(i8_conditionEQ(0, I8_MAX), 0);
	ASSERTU1(i8_conditionEQ(0, I8_MIN), 0);
	ASSERTU1(i8_conditionEQ(1, 0), 0);
	ASSERTU1(i8_conditionEQ(1, 1), 1);
	ASSERTU1(i8_conditionEQ(1, I8_MAX), 0);
	ASSERTU1(i8_conditionEQ(1, I8_MIN), 0);
	ASSERTU1(i8_conditionEQ(I8_MAX, 0), 0);
	ASSERTU1(i8_conditionEQ(I8_MAX, 1), 0);
	ASSERTU1(i8_conditionEQ(I8_MAX, I8_MAX), 1);
	ASSERTU1(i8_conditionEQ(I8_MAX, I8_MIN), 0);
	ASSERTU1(i8_conditionEQ(I8_MIN, 0), 0);
	ASSERTU1(i8_conditionEQ(I8_MIN, 1), 0);
	ASSERTU1(i8_conditionEQ(I8_MIN, I8_MAX), 0);
	ASSERTU1(i8_conditionEQ(I8_MIN, I8_MIN), 1);

	ASSERTU1(i8_conditionEQUnused(0, 0, 0), 1);
	ASSERTU1(i8_conditionEQUnused(0, 0, 1), 0);
	ASSERTU1(i8_conditionEQUnused(0, 0, I8_MAX), 0);
	ASSERTU1(i8_conditionEQUnused(0, 0, I8_MIN), 0);
	ASSERTU1(i8_conditionEQUnused(0, 1, 0), 0);
	ASSERTU1(i8_conditionEQUnused(0, 1, 1), 1);
	ASSERTU1(i8_conditionEQUnused(0, 1, I8_MAX), 0);
	ASSERTU1(i8_conditionEQUnused(0, 1, I8_MIN), 0);
	ASSERTU1(i8_conditionEQUnused(0, I8_MAX, 0), 0);
	ASSERTU1(i8_conditionEQUnused(0, I8_MAX, 1), 0);
	ASSERTU1(i8_conditionEQUnused(0, I8_MAX, I8_MAX), 1);
	ASSERTU1(i8_conditionEQUnused(0, I8_MAX, I8_MIN), 0);
	ASSERTU1(i8_conditionEQUnused(0, I8_MIN, 0), 0);
	ASSERTU1(i8_conditionEQUnused(0, I8_MIN, 1), 0);
	ASSERTU1(i8_conditionEQUnused(0, I8_MIN, I8_MAX), 0);
	ASSERTU1(i8_conditionEQUnused(0, I8_MIN, I8_MIN), 1);

	ASSERTU1(i8_conditionEQZero(0), 1);
	ASSERTU1(i8_conditionEQZero(1), 0);
	ASSERTU1(i8_conditionEQZero(I8_MAX), 0);
	ASSERTU1(i8_conditionEQZero(I8_MIN), 0);

	ASSERTU1(i8_conditionEQOne(0), 0);
	ASSERTU1(i8_conditionEQOne(1), 1);
	ASSERTU1(i8_conditionEQOne(I8_MAX), 0);
	ASSERTU1(i8_conditionEQOne(I8_MIN), 0);
}

