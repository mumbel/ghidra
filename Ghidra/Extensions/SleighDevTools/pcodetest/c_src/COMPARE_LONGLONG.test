#include "pcode_test.h"

#ifdef HAS_LONGLONG

TEST i8_compareLogic_Main()
{
	extern i8 i8_compareLogic(i8 lhs, i8 rhs);
	ASSERTI8(i8_compareLogic(0x1, 0x1), 66);
	ASSERTI8(i8_compareLogic(0x1, 0x2), 38);
	ASSERTI8(i8_compareLogic(0x2, 0x1), 42);
	ASSERTI8(i8_compareLogic(-0x1, -0x1), 65);
	ASSERTI8(i8_compareLogic(-0x1, -0x2), 41);
	ASSERTI8(i8_compareLogic(-0x2, -0x1), 37);
}


TEST u8_compareLogic_Main()
{
	extern u8 u8_compareLogic(u8 lhs, u8 rhs);
	ASSERTU8(u8_compareLogic(0x1, 0x1), 66);
	ASSERTU8(u8_compareLogic(0x1, 0x2), 38);
	ASSERTU8(u8_compareLogic(0x2, 0x1), 42);
}


TEST u8_conditionGT_Main()
{
	extern u1 u8_conditionGT(u8 lhs, u8 rhs);
	extern u1 u8_conditionGTUnused(u8 val, u8 lhs, u8 rhs);
	extern u1 u8_conditionGTZero(u8 val);
	extern u1 u8_conditionGTOne(u8 val);

	ASSERTU1(u8_conditionGT(0, 0), 0);
	ASSERTU1(u8_conditionGT(0, 1), 0);
	ASSERTU1(u8_conditionGT(0, U8_MAX), 0);
	ASSERTU1(u8_conditionGT(1, 0), 1);
	ASSERTU1(u8_conditionGT(1, 1), 0);
	ASSERTU1(u8_conditionGT(1, U8_MAX), 0);
	ASSERTU1(u8_conditionGT(U8_MAX, 0), 1);
	ASSERTU1(u8_conditionGT(U8_MAX, 1), 1);
	ASSERTU1(u8_conditionGT(U8_MAX, U8_MAX), 0);

	ASSERTU1(u8_conditionGTUnused(0, 0, 0), 0);
	ASSERTU1(u8_conditionGTUnused(0, 0, 1), 0);
	ASSERTU1(u8_conditionGTUnused(0, 0, U8_MAX), 0);
	ASSERTU1(u8_conditionGTUnused(0, 1, 0), 1);
	ASSERTU1(u8_conditionGTUnused(0, 1, 1), 0);
	ASSERTU1(u8_conditionGTUnused(0, 1, U8_MAX), 0);
	ASSERTU1(u8_conditionGTUnused(0, U8_MAX, 0), 1);
	ASSERTU1(u8_conditionGTUnused(0, U8_MAX, 1), 1);
	ASSERTU1(u8_conditionGTUnused(0, U8_MAX, U8_MAX), 0);

	ASSERTU1(u8_conditionGTZero(0), 0);
	ASSERTU1(u8_conditionGTZero(1), 1);
	ASSERTU1(u8_conditionGTZero(U8_MAX), 1);

	ASSERTU1(u8_conditionGTOne(0), 0);
	ASSERTU1(u8_conditionGTOne(1), 0);
	ASSERTU1(u8_conditionGTOne(U8_MAX), 1);
}

