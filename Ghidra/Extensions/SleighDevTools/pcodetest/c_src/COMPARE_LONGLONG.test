	ASSERTU1(i8_conditionLEUnused(0, I8_MAX, I8_MIN), 0);
	ASSERTU1(i8_conditionLEUnused(0, I8_MIN, 0), 1);
	ASSERTU1(i8_conditionLEUnused(0, I8_MIN, 1), 1);
	ASSERTU1(i8_conditionLEUnused(0, I8_MIN, I8_MAX), 1);
	ASSERTU1(i8_conditionLEUnused(0, I8_MIN, I8_MIN), 1);

	ASSERTU1(i8_conditionLEZero(0), 1);
	ASSERTU1(i8_conditionLEZero(1), 0);
	ASSERTU1(i8_conditionLEZero(I8_MAX), 0);
	ASSERTU1(i8_conditionLEZero(I8_MIN), 1);

	ASSERTU1(i8_conditionLEOne(0), 1);
