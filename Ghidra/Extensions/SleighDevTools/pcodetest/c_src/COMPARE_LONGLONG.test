	ASSERTU1(i8_conditionLEUnused(0, 0, 0), 1);
	ASSERTU1(i8_conditionLEUnused(0, 0, 1), 1);
	ASSERTU1(i8_conditionLEUnused(0, 0, I8_MAX), 1);
	ASSERTU1(i8_conditionLEUnused(0, 0, I8_MIN), 0);
	ASSERTU1(i8_conditionLEUnused(0, 1, 0), 0);
	ASSERTU1(i8_conditionLEUnused(0, 1, 1), 1);
	ASSERTU1(i8_conditionLEUnused(0, 1, I8_MAX), 1);
	ASSERTU1(i8_conditionLEUnused(0, 1, I8_MIN), 0);
	ASSERTU1(i8_conditionLEUnused(0, I8_MAX, 0), 0);
