#include "pcode_test.h"

#ifdef HAS_FLOAT

TEST f4_compareLogic_Main()
{
	extern f4 f4_compareLogic(f4 lhs, f4 rhs);
	ASSERTF4(f4_compareLogic(0x1, 0x1), 66);
	ASSERTF4(f4_compareLogic(0x1, 0x2), 38);
	ASSERTF4(f4_compareLogic(0x2, 0x1), 42);
	ASSERTF4(f4_compareLogic(-0x1, -0x1), 65);
	ASSERTF4(f4_compareLogic(-0x1, -0x2), 41);
	ASSERTF4(f4_compareLogic(-0x2, -0x1), 37);
}


/* Logical operators */
TEST f4_logicalAnd_Main()
{
	extern f4 f4_logicalAnd(f4 lhs, f4 rhs);
	ASSERTF4(f4_logicalAnd(2, 1), 1);
	ASSERTF4(f4_logicalAnd(PI_SHORT, PI_SHORT), 1);
	ASSERTF4(f4_logicalAnd(PI_SHORT, 0), 0.0);
}


TEST f4_logicalOr_Main()
{
	extern f4 f4_logicalOr(f4 lhs, f4 rhs);
	ASSERTF4(f4_logicalOr(2, 1), 1);
	ASSERTF4(f4_logicalOr(PI_SHORT, PI_SHORT), 1);
	ASSERTF4(f4_logicalOr(PI_SHORT, 0), 1);
}


/* Arithmetic operators */

TEST f4_addition_Main()
{
	extern f4 f4_addition(f4 lhs, f4 rhs);
	ASSERTF4(f4_addition(2, 1), 3);
	ASSERTF4(f4_addition(PI_SHORT, PI_SHORT), 6.280000);
}


TEST f4_subtract_Main()
{
	extern f4 f4_subtract(f4 lhs, f4 rhs);
	ASSERTF4(f4_subtract(2, 1), 1);
	ASSERTF4(f4_subtract(PI_SHORT, PI_SHORT), 0.0);
}


TEST f4_multiply_Main()
{
	extern f4 f4_multiply(f4 lhs, f4 rhs);
	ASSERTF4(f4_multiply(2, 1), 2);
	ASSERTF4(f4_multiply(PI_SHORT, PI_SHORT), 9.859601);
}


TEST f4_conditionGT_Main()
{
	extern u1 f4_conditionGT(f4 lhs, f4 rhs);
	extern u1 f4_conditionGTZero(f4 val);
	extern u1 f4_conditionGTOne(f4 val);

	ASSERTU1(f4_conditionGT(+0.0, +0.0), 0);
	ASSERTU1(f4_conditionGT(+0.0, 1.0), 0);
	ASSERTU1(f4_conditionGT(+0.0, PI_SHORT), 0);
	ASSERTU1(f4_conditionGT(+0.0, -PI_SHORT), 1);
	ASSERTU1(f4_conditionGT(1.0, +0.0), 1);
	ASSERTU1(f4_conditionGT(1.0, 1.0), 0);
	ASSERTU1(f4_conditionGT(1.0, PI_SHORT), 0);
	ASSERTU1(f4_conditionGT(1.0, -PI_SHORT), 1);
	ASSERTU1(f4_conditionGT(PI_SHORT, +0.0), 1);
	ASSERTU1(f4_conditionGT(PI_SHORT, 1.0), 1);
	ASSERTU1(f4_conditionGT(PI_SHORT, PI_SHORT), 0);
	ASSERTU1(f4_conditionGT(PI_SHORT, -PI_SHORT), 1);
	ASSERTU1(f4_conditionGT(-PI_SHORT, +0.0), 0);
	ASSERTU1(f4_conditionGT(-PI_SHORT, 1.0), 0);
	ASSERTU1(f4_conditionGT(-PI_SHORT, PI_SHORT), 0);
	ASSERTU1(f4_conditionGT(-PI_SHORT, -PI_SHORT), 0);

	ASSERTU1(f4_conditionGTZero(+0.0), 0);
	ASSERTU1(f4_conditionGTZero(1.0), 1);
	ASSERTU1(f4_conditionGTZero(PI_SHORT), 1);
	ASSERTU1(f4_conditionGTZero(-PI_SHORT), 0);

	ASSERTU1(f4_conditionGTOne(+0.0), 0);
	ASSERTU1(f4_conditionGTOne(1.0), 0);
	ASSERTU1(f4_conditionGTOne(PI_SHORT), 1);
	ASSERTU1(f4_conditionGTOne(-PI_SHORT), 0);
}

TEST f4_conditionGE_Main()
{
	extern u1 f4_conditionGE(f4 lhs, f4 rhs);
	extern u1 f4_conditionGEZero(f4 val);
	extern u1 f4_conditionGEOne(f4 val);

	ASSERTU1(f4_conditionGE(+0.0, +0.0), 1);
	ASSERTU1(f4_conditionGE(+0.0, 1.0), 0);
	ASSERTU1(f4_conditionGE(+0.0, PI_SHORT), 0);
	ASSERTU1(f4_conditionGE(+0.0, -PI_SHORT), 1);
	ASSERTU1(f4_conditionGE(1.0, +0.0), 1);
	ASSERTU1(f4_conditionGE(1.0, 1.0), 1);
	ASSERTU1(f4_conditionGE(1.0, PI_SHORT), 0);
	ASSERTU1(f4_conditionGE(1.0, -PI_SHORT), 1);
	ASSERTU1(f4_conditionGE(PI_SHORT, +0.0), 1);
	ASSERTU1(f4_conditionGE(PI_SHORT, 1.0), 1);
	ASSERTU1(f4_conditionGE(PI_SHORT, PI_SHORT), 1);
	ASSERTU1(f4_conditionGE(PI_SHORT, -PI_SHORT), 1);
	ASSERTU1(f4_conditionGE(-PI_SHORT, +0.0), 0);
	ASSERTU1(f4_conditionGE(-PI_SHORT, 1.0), 0);
	ASSERTU1(f4_conditionGE(-PI_SHORT, PI_SHORT), 0);
	ASSERTU1(f4_conditionGE(-PI_SHORT, -PI_SHORT), 1);

	ASSERTU1(f4_conditionGEZero(+0.0), 1);
	ASSERTU1(f4_conditionGEZero(1.0), 1);
	ASSERTU1(f4_conditionGEZero(PI_SHORT), 1);
	ASSERTU1(f4_conditionGEZero(-PI_SHORT), 0);

	ASSERTU1(f4_conditionGEOne(+0.0), 0);
	ASSERTU1(f4_conditionGEOne(1.0), 1);
	ASSERTU1(f4_conditionGEOne(PI_SHORT), 1);
	ASSERTU1(f4_conditionGEOne(-PI_SHORT), 0);
}

TEST f4_conditionEQ_Main()
{
	extern u1 f4_conditionEQ(f4 lhs, f4 rhs);
	extern u1 f4_conditionEQZero(f4 val);
	extern u1 f4_conditionEQOne(f4 val);

	ASSERTU1(f4_conditionEQ(+0.0, +0.0), 1);
	ASSERTU1(f4_conditionEQ(+0.0, 1.0), 0);
	ASSERTU1(f4_conditionEQ(+0.0, PI_SHORT), 0);
	ASSERTU1(f4_conditionEQ(+0.0, -PI_SHORT), 0);
	ASSERTU1(f4_conditionEQ(1.0, +0.0), 0);
	ASSERTU1(f4_conditionEQ(1.0, 1.0), 1);
	ASSERTU1(f4_conditionEQ(1.0, PI_SHORT), 0);
	ASSERTU1(f4_conditionEQ(1.0, -PI_SHORT), 0);
	ASSERTU1(f4_conditionEQ(PI_SHORT, +0.0), 0);
	ASSERTU1(f4_conditionEQ(PI_SHORT, 1.0), 0);
	ASSERTU1(f4_conditionEQ(PI_SHORT, PI_SHORT), 1);
	ASSERTU1(f4_conditionEQ(PI_SHORT, -PI_SHORT), 0);
	ASSERTU1(f4_conditionEQ(-PI_SHORT, +0.0), 0);
	ASSERTU1(f4_conditionEQ(-PI_SHORT, 1.0), 0);
	ASSERTU1(f4_conditionEQ(-PI_SHORT, PI_SHORT), 0);
	ASSERTU1(f4_conditionEQ(-PI_SHORT, -PI_SHORT), 1);

	ASSERTU1(f4_conditionEQZero(+0.0), 1);
	ASSERTU1(f4_conditionEQZero(1.0), 0);
	ASSERTU1(f4_conditionEQZero(PI_SHORT), 0);
	ASSERTU1(f4_conditionEQZero(-PI_SHORT), 0);

	ASSERTU1(f4_conditionEQOne(+0.0), 0);
	ASSERTU1(f4_conditionEQOne(1.0), 1);
	ASSERTU1(f4_conditionEQOne(PI_SHORT), 0);
	ASSERTU1(f4_conditionEQOne(-PI_SHORT), 0);
}

TEST f4_conditionLE_Main()
{
	extern u1 f4_conditionLE(f4 lhs, f4 rhs);
	extern u1 f4_conditionLEZero(f4 val);
	extern u1 f4_conditionLEOne(f4 val);

	ASSERTU1(f4_conditionLE(+0.0, +0.0), 1);
	ASSERTU1(f4_conditionLE(+0.0, 1.0), 1);
	ASSERTU1(f4_conditionLE(+0.0, PI_SHORT), 1);
	ASSERTU1(f4_conditionLE(+0.0, -PI_SHORT), 0);
	ASSERTU1(f4_conditionLE(1.0, +0.0), 0);
	ASSERTU1(f4_conditionLE(1.0, 1.0), 1);
	ASSERTU1(f4_conditionLE(1.0, PI_SHORT), 1);
	ASSERTU1(f4_conditionLE(1.0, -PI_SHORT), 0);
	ASSERTU1(f4_conditionLE(PI_SHORT, +0.0), 0);
	ASSERTU1(f4_conditionLE(PI_SHORT, 1.0), 0);
	ASSERTU1(f4_conditionLE(PI_SHORT, PI_SHORT), 1);
	ASSERTU1(f4_conditionLE(PI_SHORT, -PI_SHORT), 0);
	ASSERTU1(f4_conditionLE(-PI_SHORT, +0.0), 1);
	ASSERTU1(f4_conditionLE(-PI_SHORT, 1.0), 1);
	ASSERTU1(f4_conditionLE(-PI_SHORT, PI_SHORT), 1);
	ASSERTU1(f4_conditionLE(-PI_SHORT, -PI_SHORT), 1);

	ASSERTU1(f4_conditionLEZero(+0.0), 1);
	ASSERTU1(f4_conditionLEZero(1.0), 0);
	ASSERTU1(f4_conditionLEZero(PI_SHORT), 0);
	ASSERTU1(f4_conditionLEZero(-PI_SHORT), 1);

	ASSERTU1(f4_conditionLEOne(+0.0), 1);
	ASSERTU1(f4_conditionLEOne(1.0), 1);
	ASSERTU1(f4_conditionLEOne(PI_SHORT), 0);
	ASSERTU1(f4_conditionLEOne(-PI_SHORT), 1);
}

TEST f4_conditionLT_Main()
{
	extern u1 f4_conditionLT(f4 lhs, f4 rhs);
	extern u1 f4_conditionLTZero(f4 val);
	extern u1 f4_conditionLTOne(f4 val);

	ASSERTU1(f4_conditionLT(+0.0, +0.0), 0);
	ASSERTU1(f4_conditionLT(+0.0, 1.0), 1);
	ASSERTU1(f4_conditionLT(+0.0, PI_SHORT), 1);
	ASSERTU1(f4_conditionLT(+0.0, -PI_SHORT), 0);
	ASSERTU1(f4_conditionLT(1.0, +0.0), 0);
	ASSERTU1(f4_conditionLT(1.0, 1.0), 0);
	ASSERTU1(f4_conditionLT(1.0, PI_SHORT), 1);
	ASSERTU1(f4_conditionLT(1.0, -PI_SHORT), 0);
	ASSERTU1(f4_conditionLT(PI_SHORT, +0.0), 0);
	ASSERTU1(f4_conditionLT(PI_SHORT, 1.0), 0);
	ASSERTU1(f4_conditionLT(PI_SHORT, PI_SHORT), 0);
	ASSERTU1(f4_conditionLT(PI_SHORT, -PI_SHORT), 0);
	ASSERTU1(f4_conditionLT(-PI_SHORT, +0.0), 1);
	ASSERTU1(f4_conditionLT(-PI_SHORT, 1.0), 1);
	ASSERTU1(f4_conditionLT(-PI_SHORT, PI_SHORT), 1);
	ASSERTU1(f4_conditionLT(-PI_SHORT, -PI_SHORT), 0);

	ASSERTU1(f4_conditionLTZero(+0.0), 0);
	ASSERTU1(f4_conditionLTZero(1.0), 0);
	ASSERTU1(f4_conditionLTZero(PI_SHORT), 0);
	ASSERTU1(f4_conditionLTZero(-PI_SHORT), 1);

	ASSERTU1(f4_conditionLTOne(+0.0), 1);
	ASSERTU1(f4_conditionLTOne(1.0), 0);
	ASSERTU1(f4_conditionLTOne(PI_SHORT), 0);
	ASSERTU1(f4_conditionLTOne(-PI_SHORT), 1);
}

TEST f4_conditionNE_Main()
{
	extern u1 f4_conditionNE(f4 lhs, f4 rhs);
	extern u1 f4_conditionNEZero(f4 val);
	extern u1 f4_conditionNEOne(f4 val);

	ASSERTU1(f4_conditionNE(+0.0, +0.0), 0);
	ASSERTU1(f4_conditionNE(+0.0, 1.0), 1);
	ASSERTU1(f4_conditionNE(+0.0, PI_SHORT), 1);
	ASSERTU1(f4_conditionNE(+0.0, -PI_SHORT), 1);
	ASSERTU1(f4_conditionNE(1.0, +0.0), 1);
	ASSERTU1(f4_conditionNE(1.0, 1.0), 0);
	ASSERTU1(f4_conditionNE(1.0, PI_SHORT), 1);
	ASSERTU1(f4_conditionNE(1.0, -PI_SHORT), 1);
	ASSERTU1(f4_conditionNE(PI_SHORT, +0.0), 1);
	ASSERTU1(f4_conditionNE(PI_SHORT, 1.0), 1);
	ASSERTU1(f4_conditionNE(PI_SHORT, PI_SHORT), 0);
	ASSERTU1(f4_conditionNE(PI_SHORT, -PI_SHORT), 1);
	ASSERTU1(f4_conditionNE(-PI_SHORT, +0.0), 1);
	ASSERTU1(f4_conditionNE(-PI_SHORT, 1.0), 1);
	ASSERTU1(f4_conditionNE(-PI_SHORT, PI_SHORT), 1);
	ASSERTU1(f4_conditionNE(-PI_SHORT, -PI_SHORT), 0);

	ASSERTU1(f4_conditionNEZero(+0.0), 0);
	ASSERTU1(f4_conditionNEZero(1.0), 1);
	ASSERTU1(f4_conditionNEZero(PI_SHORT), 1);
	ASSERTU1(f4_conditionNEZero(-PI_SHORT), 1);

	ASSERTU1(f4_conditionNEOne(+0.0), 1);
	ASSERTU1(f4_conditionNEOne(1.0), 0);
	ASSERTU1(f4_conditionNEOne(PI_SHORT), 1);
	ASSERTU1(f4_conditionNEOne(-PI_SHORT), 1);
}

#endif /* HAS_FLOAT */


MAIN BIOPS_FLOAT_main() { }
