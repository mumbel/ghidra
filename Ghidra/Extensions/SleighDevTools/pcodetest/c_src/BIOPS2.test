}

TEST i2_minimum_Main()
{
	extern i2 i2_minimumNew(i2 lhs, i2 rhs);
	extern i2 i2_minimum(i2 lhs, i2 rhs);

	ASSERTI2(i2_minimumNew(0, 0), 0);
	ASSERTI2(i2_minimum(0, 0), 0);
	ASSERTI2(i2_minimumNew(0, 1), 0);
	ASSERTI2(i2_minimum(0, 1), 0);
	ASSERTI2(i2_minimumNew(0, -1), -1);
	ASSERTI2(i2_minimum(0, -1), -1);
	ASSERTI2(i2_minimumNew(0, I2_MAX), 0);
	ASSERTI2(i2_minimum(0, I2_MAX), 0);
	ASSERTI2(i2_minimumNew(0, I2_MIN), I2_MIN);
	ASSERTI2(i2_minimum(0, I2_MIN), I2_MIN);
	ASSERTI2(i2_minimumNew(1, 0), 0);
	ASSERTI2(i2_minimum(1, 0), 0);
	ASSERTI2(i2_minimumNew(1, 1), 1);
	ASSERTI2(i2_minimum(1, 1), 1);
	ASSERTI2(i2_minimumNew(1, -1), -1);
	ASSERTI2(i2_minimum(1, -1), -1);
	ASSERTI2(i2_minimumNew(1, I2_MAX), 1);
	ASSERTI2(i2_minimum(1, I2_MAX), 1);
	ASSERTI2(i2_minimumNew(1, I2_MIN), I2_MIN);
	ASSERTI2(i2_minimum(1, I2_MIN), I2_MIN);
	ASSERTI2(i2_minimumNew(I2_MAX, 0), 0);
	ASSERTI2(i2_minimum(I2_MAX, 0), 0);
	ASSERTI2(i2_minimumNew(I2_MAX, 1), 1);
	ASSERTI2(i2_minimum(I2_MAX, 1), 1);
	ASSERTI2(i2_minimumNew(I2_MAX, -1), -1);
	ASSERTI2(i2_minimum(I2_MAX, -1), -1);
	ASSERTI2(i2_minimumNew(I2_MAX, I2_MAX), I2_MAX);
	ASSERTI2(i2_minimum(I2_MAX, I2_MAX), I2_MAX);
	ASSERTI2(i2_minimumNew(I2_MAX, I2_MIN), I2_MIN);
	ASSERTI2(i2_minimum(I2_MAX, I2_MIN), I2_MIN);
	ASSERTI2(i2_minimumNew(I2_MIN, 0), I2_MIN);
	ASSERTI2(i2_minimum(I2_MIN, 0), I2_MIN);
	ASSERTI2(i2_minimumNew(I2_MIN, 1), I2_MIN);
	ASSERTI2(i2_minimum(I2_MIN, 1), I2_MIN);
	ASSERTI2(i2_minimumNew(I2_MIN, -1), I2_MIN);
	ASSERTI2(i2_minimum(I2_MIN, -1), I2_MIN);
	ASSERTI2(i2_minimumNew(I2_MIN, I2_MAX), I2_MIN);
	ASSERTI2(i2_minimum(I2_MIN, I2_MAX), I2_MIN);
	ASSERTI2(i2_minimumNew(I2_MIN, I2_MIN), I2_MIN);
	ASSERTI2(i2_minimum(I2_MIN, I2_MIN), I2_MIN);
}

TEST i2_maximum_Main()
{
	extern i2 i2_maximumNew(i2 lhs, i2 rhs);
	extern i2 i2_maximum(i2 lhs, i2 rhs);

	ASSERTI2(i2_maximumNew(0, 0), 0);
	ASSERTI2(i2_maximum(0, 0), 0);
	ASSERTI2(i2_maximumNew(0, 1), 1);
	ASSERTI2(i2_maximum(0, 1), 1);
	ASSERTI2(i2_maximumNew(0, -1), 0);
	ASSERTI2(i2_maximum(0, -1), 0);
	ASSERTI2(i2_maximumNew(0, I2_MAX), I2_MAX);
	ASSERTI2(i2_maximum(0, I2_MAX), I2_MAX);
	ASSERTI2(i2_maximumNew(0, I2_MIN), 0);
	ASSERTI2(i2_maximum(0, I2_MIN), 0);
	ASSERTI2(i2_maximumNew(1, 0), 1);
	ASSERTI2(i2_maximum(1, 0), 1);
	ASSERTI2(i2_maximumNew(1, 1), 1);
	ASSERTI2(i2_maximum(1, 1), 1);
	ASSERTI2(i2_maximumNew(1, -1), 1);
	ASSERTI2(i2_maximum(1, -1), 1);
	ASSERTI2(i2_maximumNew(1, I2_MAX), I2_MAX);
	ASSERTI2(i2_maximum(1, I2_MAX), I2_MAX);
	ASSERTI2(i2_maximumNew(1, I2_MIN), 1);
	ASSERTI2(i2_maximum(1, I2_MIN), 1);
	ASSERTI2(i2_maximumNew(I2_MAX, 0), I2_MAX);
	ASSERTI2(i2_maximum(I2_MAX, 0), I2_MAX);
	ASSERTI2(i2_maximumNew(I2_MAX, 1), I2_MAX);
	ASSERTI2(i2_maximum(I2_MAX, 1), I2_MAX);
	ASSERTI2(i2_maximumNew(I2_MAX, -1), I2_MAX);
	ASSERTI2(i2_maximum(I2_MAX, -1), I2_MAX);
	ASSERTI2(i2_maximumNew(I2_MAX, I2_MAX), I2_MAX);
	ASSERTI2(i2_maximum(I2_MAX, I2_MAX), I2_MAX);
	ASSERTI2(i2_maximumNew(I2_MAX, I2_MIN), I2_MAX);
	ASSERTI2(i2_maximum(I2_MAX, I2_MIN), I2_MAX);
	ASSERTI2(i2_maximumNew(I2_MIN, 0), 0);
	ASSERTI2(i2_maximum(I2_MIN, 0), 0);
	ASSERTI2(i2_maximumNew(I2_MIN, 1), 1);
	ASSERTI2(i2_maximum(I2_MIN, 1), 1);
	ASSERTI2(i2_maximumNew(I2_MIN, -1), -1);
	ASSERTI2(i2_maximum(I2_MIN, -1), -1);
	ASSERTI2(i2_maximumNew(I2_MIN, I2_MAX), I2_MAX);
	ASSERTI2(i2_maximum(I2_MIN, I2_MAX), I2_MAX);
	ASSERTI2(i2_maximumNew(I2_MIN, I2_MIN), I2_MIN);
	ASSERTI2(i2_maximum(I2_MIN, I2_MIN), I2_MIN);
}


