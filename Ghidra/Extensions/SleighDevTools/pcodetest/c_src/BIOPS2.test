	ASSERTU1(i2_conditionLEUnused(0, 0, I2_MIN), 0);
	ASSERTU1(i2_conditionLEUnused(0, 1, 0), 0);
	ASSERTU1(i2_conditionLEUnused(0, 1, 1), 1);
	ASSERTU1(i2_conditionLEUnused(0, 1, I2_MAX), 1);
	ASSERTU1(i2_conditionLEUnused(0, 1, I2_MIN), 0);
	ASSERTU1(i2_conditionLEUnused(0, I2_MAX, 0), 0);
	ASSERTU1(i2_conditionLEUnused(0, I2_MAX, 1), 0);
	ASSERTU1(i2_conditionLEUnused(0, I2_MAX, I2_MAX), 1);
	ASSERTU1(i2_conditionLEUnused(0, I2_MAX, I2_MIN), 0);
	ASSERTU1(i2_conditionLEUnused(0, I2_MIN, 0), 1);
	ASSERTU1(i2_conditionLEUnused(0, I2_MIN, 1), 1);
	ASSERTU1(i2_conditionLEUnused(0, I2_MIN, I2_MAX), 1);
	ASSERTU1(i2_conditionLEUnused(0, I2_MIN, I2_MIN), 1);

	ASSERTU1(i2_conditionLEZero(0), 1);
	ASSERTU1(i2_conditionLEZero(1), 0);
	ASSERTU1(i2_conditionLEZero(I2_MAX), 0);
	ASSERTU1(i2_conditionLEZero(I2_MIN), 1);

	ASSERTU1(i2_conditionLEOne(0), 1);
	ASSERTU1(i2_conditionLEOne(1), 1);
	ASSERTU1(i2_conditionLEOne(I2_MAX), 0);
	ASSERTU1(i2_conditionLEOne(I2_MIN), 1);
}

