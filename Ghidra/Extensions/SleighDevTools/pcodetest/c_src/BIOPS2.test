TEST u2_minimum_Main()
{
	extern u2 u2_minimumNew(u2 lhs, u2 rhs);
	extern u2 u2_minimum(u2 lhs, u2 rhs);

	ASSERTU2(u2_minimumNew(0, 0), 0);
	ASSERTU2(u2_minimum(0, 0), 0);
	ASSERTU2(u2_minimumNew(0, 1), 0);
	ASSERTU2(u2_minimum(0, 1), 0);
	ASSERTU2(u2_minimumNew(0, U2_MAX), 0);
	ASSERTU2(u2_minimum(0, U2_MAX), 0);
	ASSERTU2(u2_minimumNew(1, 0), 0);
	ASSERTU2(u2_minimum(1, 0), 0);
	ASSERTU2(u2_minimumNew(1, 1), 1);
	ASSERTU2(u2_minimum(1, 1), 1);
	ASSERTU2(u2_minimumNew(1, U2_MAX), 1);
	ASSERTU2(u2_minimum(1, U2_MAX), 1);
	ASSERTU2(u2_minimumNew(U2_MAX, 0), 0);
	ASSERTU2(u2_minimum(U2_MAX, 0), 0);
	ASSERTU2(u2_minimumNew(U2_MAX, 1), 1);
	ASSERTU2(u2_minimum(U2_MAX, 1), 1);
	ASSERTU2(u2_minimumNew(U2_MAX, U2_MAX), U2_MAX);
	ASSERTU2(u2_minimum(U2_MAX, U2_MAX), U2_MAX);
}

TEST u2_maximum_Main()
{
