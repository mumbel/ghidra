	ASSERTU1(u1_conditionLT(0, 0), 0);
	ASSERTU1(u1_conditionLT(0, 1), 1);
	ASSERTU1(u1_conditionLT(0, U1_MAX), 1);
	ASSERTU1(u1_conditionLT(1, 0), 0);
