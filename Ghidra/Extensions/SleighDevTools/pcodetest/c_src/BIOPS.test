	ASSERTU1(u1_conditionLTUnused(0, 0, 0), 0);
	ASSERTU1(u1_conditionLTUnused(0, 0, 1), 1);
	ASSERTU1(u1_conditionLTUnused(0, 0, U1_MAX), 1);
	ASSERTU1(u1_conditionLTUnused(0, 1, 0), 0);
	ASSERTU1(u1_conditionLTUnused(0, 1, 1), 0);
	ASSERTU1(u1_conditionLTUnused(0, 1, U1_MAX), 1);
	ASSERTU1(u1_conditionLTUnused(0, U1_MAX, 0), 0);
	ASSERTU1(u1_conditionLTUnused(0, U1_MAX, 1), 0);
	ASSERTU1(u1_conditionLTUnused(0, U1_MAX, U1_MAX), 0);

	ASSERTU1(u1_conditionLTZero(0), 0);
	ASSERTU1(u1_conditionLTZero(1), 0);
	ASSERTU1(u1_conditionLTZero(U1_MAX), 0);

	ASSERTU1(u1_conditionLTOne(0), 1);
	ASSERTU1(u1_conditionLTOne(1), 0);
	ASSERTU1(u1_conditionLTOne(U1_MAX), 0);
}

TEST u1_conditionNE_Main()
{
	extern u1 u1_conditionNE(u1 lhs, u1 rhs);
	extern u1 u1_conditionNEUnused(u1 val, u1 lhs, u1 rhs);
	extern u1 u1_conditionNEZero(u1 val);
	extern u1 u1_conditionNEOne(u1 val);

	ASSERTU1(u1_conditionNE(0, 0), 0);
	ASSERTU1(u1_conditionNE(0, 1), 1);
	ASSERTU1(u1_conditionNE(0, U1_MAX), 1);
	ASSERTU1(u1_conditionNE(1, 0), 1);
	ASSERTU1(u1_conditionNE(1, 1), 0);
	ASSERTU1(u1_conditionNE(1, U1_MAX), 1);
	ASSERTU1(u1_conditionNE(U1_MAX, 0), 1);
	ASSERTU1(u1_conditionNE(U1_MAX, 1), 1);
	ASSERTU1(u1_conditionNE(U1_MAX, U1_MAX), 0);

	ASSERTU1(u1_conditionNEUnused(0, 0, 0), 0);
	ASSERTU1(u1_conditionNEUnused(0, 0, 1), 1);
	ASSERTU1(u1_conditionNEUnused(0, 0, U1_MAX), 1);
	ASSERTU1(u1_conditionNEUnused(0, 1, 0), 1);
	ASSERTU1(u1_conditionNEUnused(0, 1, 1), 0);
	ASSERTU1(u1_conditionNEUnused(0, 1, U1_MAX), 1);
	ASSERTU1(u1_conditionNEUnused(0, U1_MAX, 0), 1);
	ASSERTU1(u1_conditionNEUnused(0, U1_MAX, 1), 1);
	ASSERTU1(u1_conditionNEUnused(0, U1_MAX, U1_MAX), 0);

	ASSERTU1(u1_conditionNEZero(0), 0);
	ASSERTU1(u1_conditionNEZero(1), 1);
	ASSERTU1(u1_conditionNEZero(U1_MAX), 1);

	ASSERTU1(u1_conditionNEOne(0), 1);
	ASSERTU1(u1_conditionNEOne(1), 0);
	ASSERTU1(u1_conditionNEOne(U1_MAX), 1);
}

TEST i1_conditionGT_Main()
{
	extern u1 i1_conditionGT(i1 lhs, i1 rhs);
	extern u1 i1_conditionGTUnused(i1 val, i1 lhs, i1 rhs);
	extern u1 i1_conditionGTZero(i1 val);
	extern u1 i1_conditionGTOne(i1 val);

	ASSERTU1(i1_conditionGT(0, 0), 0);
	ASSERTU1(i1_conditionGT(0, 1), 0);
	ASSERTU1(i1_conditionGT(0, I1_MAX), 0);
	ASSERTU1(i1_conditionGT(0, I1_MIN), 1);
	ASSERTU1(i1_conditionGT(1, 0), 1);
	ASSERTU1(i1_conditionGT(1, 1), 0);
	ASSERTU1(i1_conditionGT(1, I1_MAX), 0);
	ASSERTU1(i1_conditionGT(1, I1_MIN), 1);
	ASSERTU1(i1_conditionGT(I1_MAX, 0), 1);
	ASSERTU1(i1_conditionGT(I1_MAX, 1), 1);
	ASSERTU1(i1_conditionGT(I1_MAX, I1_MAX), 0);
	ASSERTU1(i1_conditionGT(I1_MAX, I1_MIN), 1);
	ASSERTU1(i1_conditionGT(I1_MIN, 0), 0);
	ASSERTU1(i1_conditionGT(I1_MIN, 1), 0);
	ASSERTU1(i1_conditionGT(I1_MIN, I1_MAX), 0);
	ASSERTU1(i1_conditionGT(I1_MIN, I1_MIN), 0);

	ASSERTU1(i1_conditionGTUnused(0, 0, 0), 0);
