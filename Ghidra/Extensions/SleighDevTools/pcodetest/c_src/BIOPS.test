	ASSERTI1(i1_maximumNew(I1_MAX, -1), I1_MAX);
	ASSERTI1(i1_maximum(I1_MAX, -1), I1_MAX);
	ASSERTI1(i1_maximumNew(I1_MAX, I1_MAX), I1_MAX);
	ASSERTI1(i1_maximum(I1_MAX, I1_MAX), I1_MAX);
	ASSERTI1(i1_maximumNew(I1_MAX, I1_MIN), I1_MAX);
	ASSERTI1(i1_maximum(I1_MAX, I1_MIN), I1_MAX);
	ASSERTI1(i1_maximumNew(I1_MIN, 0), 0);
	ASSERTI1(i1_maximum(I1_MIN, 0), 0);
	ASSERTI1(i1_maximumNew(I1_MIN, 1), 1);
	ASSERTI1(i1_maximum(I1_MIN, 1), 1);
	ASSERTI1(i1_maximumNew(I1_MIN, -1), -1);
	ASSERTI1(i1_maximum(I1_MIN, -1), -1);
	ASSERTI1(i1_maximumNew(I1_MIN, I1_MAX), I1_MAX);
	ASSERTI1(i1_maximum(I1_MIN, I1_MAX), I1_MAX);
	ASSERTI1(i1_maximumNew(I1_MIN, I1_MIN), I1_MIN);
	ASSERTI1(i1_maximum(I1_MIN, I1_MIN), I1_MIN);
}

MAIN BIOPS_main() { }
