#include "pcode_test.h"


TEST u2_logicalNot_Main()
{
	extern u2 u2_logicalNot(u2 lhs);
	ASSERTU2(u2_logicalNot(2), 0);
	ASSERTU2(u2_logicalNot(U2_MAX), 0);
	ASSERTU2(u2_logicalNot(0), 1);
}

TEST i2_logicalNot_Main()
{
	extern i2 i2_logicalNot(i2 lhs);

	ASSERTI2(i2_logicalNot(0x0101), 0);
	ASSERTI2(i2_logicalNot(2), 0);
	ASSERTI2(i2_logicalNot(I2_MAX), 0);
	ASSERTI2(i2_logicalNot(I2_MIN), 0);
	ASSERTI2(i2_logicalNot(0), 1);
}

TEST u2_unaryPositive_Main()
{
	extern u2 u2_unaryPositive(u2 lhs);
	ASSERTU2(u2_unaryPositive(2), 2);
	ASSERTU2(u2_unaryPositive(U2_MAX), 65535);
	ASSERTU2(u2_unaryPositive(0), 0);
}

TEST u2_unaryComp_Main()
{
	extern u2 u2_unaryComp(u2 val);
	ASSERTU2(u2_unaryComp(0), U2_MAX);
	ASSERTU2(u2_unaryComp(1), U2_MAX-1);
	ASSERTU2(u2_unaryComp(U2_MAX), 0);
}

TEST u2_unaryIncPost_Main()
{
	extern u2 u2_unaryIncPost(u2 val);
	ASSERTU2(u2_unaryIncPost(0), 0);
	ASSERTU2(u2_unaryIncPost(1), 1);
	ASSERTU2(u2_unaryIncPost(U2_MAX), U2_MAX);
}

TEST u2_unaryIncPre_Main()
{
	extern u2 u2_unaryIncPre(u2 val);
	ASSERTU2(u2_unaryIncPre(0), 1);
	ASSERTU2(u2_unaryIncPre(1), 2);
	ASSERTU2(u2_unaryIncPre(U2_MAX), 0);
}

TEST u2_unaryDecPost_Main()
{
	extern u2 u2_unaryDecPost(u2 val);
	ASSERTU2(u2_unaryDecPost(0), 0);
	ASSERTU2(u2_unaryDecPost(1), 1);
	ASSERTU2(u2_unaryDecPost(U2_MAX), U2_MAX);
}

TEST u2_unaryDecPre_Main()
{
	extern u2 u2_unaryDecPre(u2 val);
	ASSERTU2(u2_unaryDecPre(0), U2_MAX);
	ASSERTU2(u2_unaryDecPre(1), 0);
	ASSERTU2(u2_unaryDecPre(U2_MAX), U2_MAX-1);
}


TEST i2_unaryNegative_Main()
{
	extern i2 i2_unaryNegative(i2 lhs);
	ASSERTI2(i2_unaryNegative(0x0101), -0x0101);
	ASSERTI2(i2_unaryNegative(-0x0101), 0x0101);
	ASSERTI2(i2_unaryNegative(I2_MAX), -32767);
	ASSERTI2(i2_unaryNegative(I2_MIN), I2_MIN);
	ASSERTI2(i2_unaryNegative(0), 0);
}

TEST i2_unaryPositive_Main()
{
	extern i2 i2_unaryPositive(i2 lhs);
	ASSERTI2(i2_unaryPositive(0x0101), 0x0101);
	ASSERTI2(i2_unaryPositive(-0x0101), -0x0101);
	ASSERTI2(i2_unaryPositive(2), 2);
	ASSERTI2(i2_unaryPositive(I2_MAX), 32767);
	ASSERTI2(i2_unaryPositive(I2_MIN), -32768);
	ASSERTI2(i2_unaryPositive(0), 0);
}

TEST i2_unaryComp_Main()
{
	extern i2 i2_unaryComp(i2 val);
	ASSERTI2(i2_unaryComp(0), -1);
	ASSERTI2(i2_unaryComp(1), -2);
	ASSERTI2(i2_unaryComp(-1), 0);
	ASSERTI2(i2_unaryComp(I2_MAX), I2_MIN);
	ASSERTI2(i2_unaryComp(I2_MIN), I2_MAX);
}

TEST i2_unaryIncPost_Main()
{
	extern i2 i2_unaryIncPost(i2 val);
	ASSERTI2(i2_unaryIncPost(0), 0);
	ASSERTI2(i2_unaryIncPost(1), 1);
	ASSERTI2(i2_unaryIncPost(-1), -1);
	ASSERTI2(i2_unaryIncPost(I2_MAX), I2_MAX);
	ASSERTI2(i2_unaryIncPost(I2_MIN), I2_MIN);
}

TEST i2_unaryIncPre_Main()
{
	extern i2 i2_unaryIncPre(i2 val);
	ASSERTI2(i2_unaryIncPre(0), 1);
	ASSERTI2(i2_unaryIncPre(1), 2);
	ASSERTI2(i2_unaryIncPre(-1), 0);
	ASSERTI2(i2_unaryIncPre(I2_MAX), I2_MIN);
	ASSERTI2(i2_unaryIncPre(I2_MIN), I2_MIN+1);
}

TEST i2_unaryDecPost_Main()
{
	extern i2 i2_unaryDecPost(i2 val);
	ASSERTI2(i2_unaryDecPost(0), 0);
	ASSERTI2(i2_unaryDecPost(1), 1);
	ASSERTI2(i2_unaryDecPost(-1), -1);
	ASSERTI2(i2_unaryDecPost(I2_MAX), I2_MAX);
	ASSERTI2(i2_unaryDecPost(I2_MIN), I2_MIN);
}

TEST i2_unaryDecPre_Main()
{
	extern i2 i2_unaryDecPre(i2 val);
	ASSERTI2(i2_unaryDecPre(0), -1);
	ASSERTI2(i2_unaryDecPre(1), 0);
	ASSERTI2(i2_unaryDecPre(-1), -2);
	ASSERTI2(i2_unaryDecPre(I2_MAX), I2_MAX-1);
	ASSERTI2(i2_unaryDecPre(I2_MIN), I2_MAX);
}

TEST u2_swap_Main()
{
	extern u2 u2_swapRef(u2 val);
	extern u2 u2_swapMaskShift(u2 val);
	extern u2 u2_swapShiftMask(u2 val);

	ASSERTU2(u2_swapRef(0x0000), 0x0000);
	ASSERTU2(u2_swapRef(0x0001), 0x0100);
	ASSERTU2(u2_swapRef(I1_MAX), 0x7f00);
	ASSERTU2(u2_swapRef(U1_MAX), 0xff00);
	ASSERTU2(u2_swapRef(U2_MAX), U2_MAX);
	ASSERTU2(u2_swapRef(0x8000), 0x0080);
	ASSERTU2(u2_swapRef(0x0080), 0x8000);

	ASSERTU2(u2_swapMaskShift(0x0000), 0x0000);
	ASSERTU2(u2_swapMaskShift(0x0001), 0x0100);
	ASSERTU2(u2_swapMaskShift(I1_MAX), 0x7f00);
	ASSERTU2(u2_swapMaskShift(U1_MAX), 0xff00);
	ASSERTU2(u2_swapMaskShift(U2_MAX), U2_MAX);
	ASSERTU2(u2_swapMaskShift(0x8000), 0x0080);
	ASSERTU2(u2_swapMaskShift(0x0080), 0x8000);

	ASSERTU2(u2_swapShiftMask(0x0000), 0x0000);
	ASSERTU2(u2_swapShiftMask(0x0001), 0x0100);
	ASSERTU2(u2_swapShiftMask(I1_MAX), 0x7f00);
	ASSERTU2(u2_swapShiftMask(U1_MAX), 0xff00);
	ASSERTU2(u2_swapShiftMask(U2_MAX), U2_MAX);
	ASSERTU2(u2_swapShiftMask(0x8000), 0x0080);
	ASSERTU2(u2_swapShiftMask(0x0080), 0x8000);
}

TEST i2_swap_Main()
{
	extern i2 i2_swapRef(i2 val);
	extern i2 i2_swapMaskShift(i2 val);
	extern i2 i2_swapShiftMask(i2 val);

	ASSERTI2(i2_swapRef(0x0000), 0x0000);
	ASSERTI2(i2_swapRef(0x0001), 0x0100);
	ASSERTI2(i2_swapRef(-1), -1);
	ASSERTI2(i2_swapRef(I1_MAX), 0x7f00);
	ASSERTI2(i2_swapRef(I1_MIN), -32513);
	ASSERTI2(i2_swapRef(U1_MAX), -256);
	ASSERTI2(i2_swapRef(I2_MAX), -129);
	ASSERTI2(i2_swapRef(I2_MIN), 128);

	ASSERTI2(i2_swapMaskShift(0x0000), 0x0000);
	ASSERTI2(i2_swapMaskShift(0x0001), 0x0100);
	ASSERTI2(i2_swapMaskShift(-1), -1);
	ASSERTI2(i2_swapMaskShift(I1_MAX), 0x7f00);
	ASSERTI2(i2_swapMaskShift(I1_MIN), -32513);
	ASSERTI2(i2_swapMaskShift(U1_MAX), -256);
	ASSERTI2(i2_swapMaskShift(I2_MAX), -129);
	ASSERTI2(i2_swapMaskShift(I2_MIN), 128);

	ASSERTI2(i2_swapShiftMask(0x0000), 0x0000);
	ASSERTI2(i2_swapShiftMask(0x0001), 0x0100);
	ASSERTI2(i2_swapShiftMask(-1), -1);
	ASSERTI2(i2_swapShiftMask(I1_MAX), 0x7f00);
	ASSERTI2(i2_swapShiftMask(I1_MIN), -32513);
	ASSERTI2(i2_swapShiftMask(U1_MAX), -256);
	ASSERTI2(i2_swapShiftMask(I2_MAX), -129);
	ASSERTI2(i2_swapShiftMask(I2_MIN), 128);
}

MAIN UNOPS2_main(){ }

