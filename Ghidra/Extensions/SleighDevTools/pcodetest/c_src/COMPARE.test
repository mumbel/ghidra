	ASSERTU1(i1_conditionGE(I1_MIN, 0), 0);
	ASSERTU1(i1_conditionGE(I1_MIN, 1), 0);
	ASSERTU1(i1_conditionGE(I1_MIN, I1_MAX), 0);
	ASSERTU1(i1_conditionGE(I1_MIN, I1_MIN), 1);

