#include "pcode_test.h"

TEST u1_compareLogic_Main()
{
	extern u1 u1_compareLogic(u1 lhs, u1 rhs);
	ASSERTU1(u1_compareLogic(0x1, 0x1), 66);
	ASSERTU1(u1_compareLogic(0x1, 0x2), 38);
	ASSERTU1(u1_compareLogic(0x2, 0x1), 42);
}


TEST i1_compareLogic_Main()
{
	extern i1 i1_compareLogic(i1 lhs, i1 rhs);
	ASSERTI1(i1_compareLogic(0x1, 0x1), 66);
	ASSERTI1(i1_compareLogic(0x1, 0x2), 38);
	ASSERTI1(i1_compareLogic(0x2, 0x1), 42);
	ASSERTI1(i1_compareLogic(-0x1, -0x1), 65);
	ASSERTI1(i1_compareLogic(-0x1, -0x2), 41);
	ASSERTI1(i1_compareLogic(-0x2, -0x1), 37);
}


TEST u1_conditionGT_Main()
{
	extern u1 u1_conditionGT(u1 lhs, u1 rhs);
	extern u1 u1_conditionGTUnused(u1 val, u1 lhs, u1 rhs);
	extern u1 u1_conditionGTZero(u1 val);
	extern u1 u1_conditionGTOne(u1 val);

	ASSERTU1(u1_conditionGT(0, 0), 0);
	ASSERTU1(u1_conditionGT(0, 1), 0);
	ASSERTU1(u1_conditionGT(0, U1_MAX), 0);
	ASSERTU1(u1_conditionGT(1, 0), 1);
	ASSERTU1(u1_conditionGT(1, 1), 0);
	ASSERTU1(u1_conditionGT(1, U1_MAX), 0);
	ASSERTU1(u1_conditionGT(U1_MAX, 0), 1);
	ASSERTU1(u1_conditionGT(U1_MAX, 1), 1);
	ASSERTU1(u1_conditionGT(U1_MAX, U1_MAX), 0);

	ASSERTU1(u1_conditionGTUnused(0, 0, 0), 0);
	ASSERTU1(u1_conditionGTUnused(0, 0, 1), 0);
	ASSERTU1(u1_conditionGTUnused(0, 0, U1_MAX), 0);
	ASSERTU1(u1_conditionGTUnused(0, 1, 0), 1);
	ASSERTU1(u1_conditionGTUnused(0, 1, 1), 0);
	ASSERTU1(u1_conditionGTUnused(0, 1, U1_MAX), 0);
	ASSERTU1(u1_conditionGTUnused(0, U1_MAX, 0), 1);
	ASSERTU1(u1_conditionGTUnused(0, U1_MAX, 1), 1);
	ASSERTU1(u1_conditionGTUnused(0, U1_MAX, U1_MAX), 0);

	ASSERTU1(u1_conditionGTZero(0), 0);
	ASSERTU1(u1_conditionGTZero(1), 1);
	ASSERTU1(u1_conditionGTZero(U1_MAX), 1);

	ASSERTU1(u1_conditionGTOne(0), 0);
	ASSERTU1(u1_conditionGTOne(1), 0);
	ASSERTU1(u1_conditionGTOne(U1_MAX), 1);
}


