	ASSERTU1(i1_conditionGEUnused(0, 1, 1), 1);
	ASSERTU1(i1_conditionGEUnused(0, 1, I1_MAX), 0);
	ASSERTU1(i1_conditionGEUnused(0, 1, I1_MIN), 1);
	ASSERTU1(i1_conditionGEUnused(0, I1_MAX, 0), 1);
	ASSERTU1(i1_conditionGEUnused(0, I1_MAX, 1), 1);
