TEST i1_conditionGT_Main()
{
	extern u1 i1_conditionGT(i1 lhs, i1 rhs);
	extern u1 i1_conditionGTUnused(i1 val, i1 lhs, i1 rhs);
	extern u1 i1_conditionGTZero(i1 val);
	extern u1 i1_conditionGTOne(i1 val);

	ASSERTU1(i1_conditionGT(0, 0), 0);
	ASSERTU1(i1_conditionGT(0, 1), 0);
	ASSERTU1(i1_conditionGT(0, I1_MAX), 0);
	ASSERTU1(i1_conditionGT(0, I1_MIN), 1);
	ASSERTU1(i1_conditionGT(1, 0), 1);
	ASSERTU1(i1_conditionGT(1, 1), 0);
	ASSERTU1(i1_conditionGT(1, I1_MAX), 0);
	ASSERTU1(i1_conditionGT(1, I1_MIN), 1);
	ASSERTU1(i1_conditionGT(I1_MAX, 0), 1);
	ASSERTU1(i1_conditionGT(I1_MAX, 1), 1);
	ASSERTU1(i1_conditionGT(I1_MAX, I1_MAX), 0);
	ASSERTU1(i1_conditionGT(I1_MAX, I1_MIN), 1);
	ASSERTU1(i1_conditionGT(I1_MIN, 0), 0);
	ASSERTU1(i1_conditionGT(I1_MIN, 1), 0);
	ASSERTU1(i1_conditionGT(I1_MIN, I1_MAX), 0);
	ASSERTU1(i1_conditionGT(I1_MIN, I1_MIN), 0);

	ASSERTU1(i1_conditionGTUnused(0, 0, 0), 0);
	ASSERTU1(i1_conditionGTUnused(0, 0, 1), 0);
	ASSERTU1(i1_conditionGTUnused(0, 0, I1_MAX), 0);
	ASSERTU1(i1_conditionGTUnused(0, 0, I1_MIN), 1);
	ASSERTU1(i1_conditionGTUnused(0, 1, 0), 1);
	ASSERTU1(i1_conditionGTUnused(0, 1, 1), 0);
	ASSERTU1(i1_conditionGTUnused(0, 1, I1_MAX), 0);
	ASSERTU1(i1_conditionGTUnused(0, 1, I1_MIN), 1);
	ASSERTU1(i1_conditionGTUnused(0, I1_MAX, 0), 1);
	ASSERTU1(i1_conditionGTUnused(0, I1_MAX, 1), 1);
	ASSERTU1(i1_conditionGTUnused(0, I1_MAX, I1_MAX), 0);
	ASSERTU1(i1_conditionGTUnused(0, I1_MAX, I1_MIN), 1);
	ASSERTU1(i1_conditionGTUnused(0, I1_MIN, 0), 0);
	ASSERTU1(i1_conditionGTUnused(0, I1_MIN, 1), 0);
	ASSERTU1(i1_conditionGTUnused(0, I1_MIN, I1_MAX), 0);
	ASSERTU1(i1_conditionGTUnused(0, I1_MIN, I1_MIN), 0);

	ASSERTU1(i1_conditionGTZero(0), 0);
	ASSERTU1(i1_conditionGTZero(1), 1);
	ASSERTU1(i1_conditionGTZero(I1_MAX), 1);
	ASSERTU1(i1_conditionGTZero(I1_MIN), 0);

	ASSERTU1(i1_conditionGTOne(0), 0);
	ASSERTU1(i1_conditionGTOne(1), 0);
	ASSERTU1(i1_conditionGTOne(I1_MAX), 1);
	ASSERTU1(i1_conditionGTOne(I1_MIN), 0);
}


