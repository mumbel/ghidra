TEST i2_conditionGT_Main()
{
	extern u1 i2_conditionGT(i2 lhs, i2 rhs);
	extern u1 i2_conditionGTUnused(i2 val, i2 lhs, i2 rhs);
	extern u1 i2_conditionGTZero(i2 val);
	extern u1 i2_conditionGTOne(i2 val);

	ASSERTU1(i2_conditionGT(0, 0), 0);
	ASSERTU1(i2_conditionGT(0, 1), 0);
	ASSERTU1(i2_conditionGT(0, I2_MAX), 0);
	ASSERTU1(i2_conditionGT(0, I2_MIN), 1);
	ASSERTU1(i2_conditionGT(1, 0), 1);
	ASSERTU1(i2_conditionGT(1, 1), 0);
	ASSERTU1(i2_conditionGT(1, I2_MAX), 0);
	ASSERTU1(i2_conditionGT(1, I2_MIN), 1);
	ASSERTU1(i2_conditionGT(I2_MAX, 0), 1);
	ASSERTU1(i2_conditionGT(I2_MAX, 1), 1);
	ASSERTU1(i2_conditionGT(I2_MAX, I2_MAX), 0);
	ASSERTU1(i2_conditionGT(I2_MAX, I2_MIN), 1);
	ASSERTU1(i2_conditionGT(I2_MIN, 0), 0);
	ASSERTU1(i2_conditionGT(I2_MIN, 1), 0);
	ASSERTU1(i2_conditionGT(I2_MIN, I2_MAX), 0);
	ASSERTU1(i2_conditionGT(I2_MIN, I2_MIN), 0);

	ASSERTU1(i2_conditionGTUnused(0, 0, 0), 0);
	ASSERTU1(i2_conditionGTUnused(0, 0, 1), 0);
	ASSERTU1(i2_conditionGTUnused(0, 0, I2_MAX), 0);
	ASSERTU1(i2_conditionGTUnused(0, 0, I2_MIN), 1);
	ASSERTU1(i2_conditionGTUnused(0, 1, 0), 1);
	ASSERTU1(i2_conditionGTUnused(0, 1, 1), 0);
	ASSERTU1(i2_conditionGTUnused(0, 1, I2_MAX), 0);
	ASSERTU1(i2_conditionGTUnused(0, 1, I2_MIN), 1);
	ASSERTU1(i2_conditionGTUnused(0, I2_MAX, 0), 1);
	ASSERTU1(i2_conditionGTUnused(0, I2_MAX, 1), 1);
	ASSERTU1(i2_conditionGTUnused(0, I2_MAX, I2_MAX), 0);
	ASSERTU1(i2_conditionGTUnused(0, I2_MAX, I2_MIN), 1);
	ASSERTU1(i2_conditionGTUnused(0, I2_MIN, 0), 0);
	ASSERTU1(i2_conditionGTUnused(0, I2_MIN, 1), 0);
	ASSERTU1(i2_conditionGTUnused(0, I2_MIN, I2_MAX), 0);
	ASSERTU1(i2_conditionGTUnused(0, I2_MIN, I2_MIN), 0);

	ASSERTU1(i2_conditionGTZero(0), 0);
	ASSERTU1(i2_conditionGTZero(1), 1);
	ASSERTU1(i2_conditionGTZero(I2_MAX), 1);
	ASSERTU1(i2_conditionGTZero(I2_MIN), 0);

	ASSERTU1(i2_conditionGTOne(0), 0);
	ASSERTU1(i2_conditionGTOne(1), 0);
	ASSERTU1(i2_conditionGTOne(I2_MAX), 1);
	ASSERTU1(i2_conditionGTOne(I2_MIN), 0);
}


TEST i2_conditionGE_Main()
{
	extern u1 i2_conditionGE(i2 lhs, i2 rhs);
	extern u1 i2_conditionGEUnused(i2 val, i2 lhs, i2 rhs);
	extern u1 i2_conditionGEZero(i2 val);
	extern u1 i2_conditionGEOne(i2 val);

	ASSERTU1(i2_conditionGE(0, 0), 1);
	ASSERTU1(i2_conditionGE(0, 1), 0);
	ASSERTU1(i2_conditionGE(0, I2_MAX), 0);
	ASSERTU1(i2_conditionGE(0, I2_MIN), 1);
	ASSERTU1(i2_conditionGE(1, 0), 1);
	ASSERTU1(i2_conditionGE(1, 1), 1);
	ASSERTU1(i2_conditionGE(1, I2_MAX), 0);
	ASSERTU1(i2_conditionGE(1, I2_MIN), 1);
	ASSERTU1(i2_conditionGE(I2_MAX, 0), 1);
	ASSERTU1(i2_conditionGE(I2_MAX, 1), 1);
	ASSERTU1(i2_conditionGE(I2_MAX, I2_MAX), 1);
	ASSERTU1(i2_conditionGE(I2_MAX, I2_MIN), 1);
	ASSERTU1(i2_conditionGE(I2_MIN, 0), 0);
	ASSERTU1(i2_conditionGE(I2_MIN, 1), 0);
	ASSERTU1(i2_conditionGE(I2_MIN, I2_MAX), 0);
	ASSERTU1(i2_conditionGE(I2_MIN, I2_MIN), 1);

	ASSERTU1(i2_conditionGEUnused(0, 0, 0), 1);
	ASSERTU1(i2_conditionGEUnused(0, 0, 1), 0);
	ASSERTU1(i2_conditionGEUnused(0, 0, I2_MAX), 0);
	ASSERTU1(i2_conditionGEUnused(0, 0, I2_MIN), 1);
	ASSERTU1(i2_conditionGEUnused(0, 1, 0), 1);
	ASSERTU1(i2_conditionGEUnused(0, 1, 1), 1);
	ASSERTU1(i2_conditionGEUnused(0, 1, I2_MAX), 0);
	ASSERTU1(i2_conditionGEUnused(0, 1, I2_MIN), 1);
	ASSERTU1(i2_conditionGEUnused(0, I2_MAX, 0), 1);
	ASSERTU1(i2_conditionGEUnused(0, I2_MAX, 1), 1);
	ASSERTU1(i2_conditionGEUnused(0, I2_MAX, I2_MAX), 1);
	ASSERTU1(i2_conditionGEUnused(0, I2_MAX, I2_MIN), 1);
	ASSERTU1(i2_conditionGEUnused(0, I2_MIN, 0), 0);
	ASSERTU1(i2_conditionGEUnused(0, I2_MIN, 1), 0);
	ASSERTU1(i2_conditionGEUnused(0, I2_MIN, I2_MAX), 0);
	ASSERTU1(i2_conditionGEUnused(0, I2_MIN, I2_MIN), 1);

	ASSERTU1(i2_conditionGEZero(0), 1);
	ASSERTU1(i2_conditionGEZero(1), 1);
	ASSERTU1(i2_conditionGEZero(I2_MAX), 1);
	ASSERTU1(i2_conditionGEZero(I2_MIN), 0);

	ASSERTU1(i2_conditionGEOne(0), 0);
	ASSERTU1(i2_conditionGEOne(1), 1);
	ASSERTU1(i2_conditionGEOne(I2_MAX), 1);
	ASSERTU1(i2_conditionGEOne(I2_MIN), 0);
}


