#include "pcode_test.h"

TEST u2_compareLogic_Main()
{
	extern u2 u2_compareLogic(u2 lhs, u2 rhs);
	ASSERTU2(u2_compareLogic(0x1, 0x1), 66);
	ASSERTU2(u2_compareLogic(0x1, 0x2), 38);
	ASSERTU2(u2_compareLogic(0x2, 0x1), 42);
}


TEST i2_compareLogic_Main()
{
	extern i2 i2_compareLogic(i2 lhs, i2 rhs);
	ASSERTI2(i2_compareLogic(0x1, 0x1), 66);
	ASSERTI2(i2_compareLogic(0x1, 0x2), 38);
	ASSERTI2(i2_compareLogic(0x2, 0x1), 42);
	ASSERTI2(i2_compareLogic(-0x1, -0x1), 65);
	ASSERTI2(i2_compareLogic(-0x1, -0x2), 41);
	ASSERTI2(i2_compareLogic(-0x2, -0x1), 37);
}


TEST u2_conditionGT_Main()
{
	extern u1 u2_conditionGT(u2 lhs, u2 rhs);
	extern u1 u2_conditionGTUnused(u2 val, u2 lhs, u2 rhs);
	extern u1 u2_conditionGTZero(u2 val);
	extern u1 u2_conditionGTOne(u2 val);

	ASSERTU1(u2_conditionGT(0, 0), 0);
	ASSERTU1(u2_conditionGT(0, 1), 0);
	ASSERTU1(u2_conditionGT(0, U2_MAX), 0);
	ASSERTU1(u2_conditionGT(1, 0), 1);
	ASSERTU1(u2_conditionGT(1, 1), 0);
	ASSERTU1(u2_conditionGT(1, U2_MAX), 0);
	ASSERTU1(u2_conditionGT(U2_MAX, 0), 1);
	ASSERTU1(u2_conditionGT(U2_MAX, 1), 1);
	ASSERTU1(u2_conditionGT(U2_MAX, U2_MAX), 0);

	ASSERTU1(u2_conditionGTUnused(0, 0, 0), 0);
	ASSERTU1(u2_conditionGTUnused(0, 0, 1), 0);
	ASSERTU1(u2_conditionGTUnused(0, 0, U2_MAX), 0);
	ASSERTU1(u2_conditionGTUnused(0, 1, 0), 1);
	ASSERTU1(u2_conditionGTUnused(0, 1, 1), 0);
	ASSERTU1(u2_conditionGTUnused(0, 1, U2_MAX), 0);
	ASSERTU1(u2_conditionGTUnused(0, U2_MAX, 0), 1);
	ASSERTU1(u2_conditionGTUnused(0, U2_MAX, 1), 1);
	ASSERTU1(u2_conditionGTUnused(0, U2_MAX, U2_MAX), 0);

	ASSERTU1(u2_conditionGTZero(0), 0);
	ASSERTU1(u2_conditionGTZero(1), 1);
	ASSERTU1(u2_conditionGTZero(U2_MAX), 1);

	ASSERTU1(u2_conditionGTOne(0), 0);
	ASSERTU1(u2_conditionGTOne(1), 0);
	ASSERTU1(u2_conditionGTOne(U2_MAX), 1);
}


