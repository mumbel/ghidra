TEST i2_conditionLT_Main()
{
	extern u1 i2_conditionLT(i2 lhs, i2 rhs);
	extern u1 i2_conditionLTUnused(i2 val, i2 lhs, i2 rhs);
	extern u1 i2_conditionLTZero(i2 val);
	extern u1 i2_conditionLTOne(i2 val);

	ASSERTU1(i2_conditionLT(0, 0), 0);
	ASSERTU1(i2_conditionLT(0, 1), 1);
	ASSERTU1(i2_conditionLT(0, I2_MAX), 1);
	ASSERTU1(i2_conditionLT(0, I2_MIN), 0);
	ASSERTU1(i2_conditionLT(1, 0), 0);
	ASSERTU1(i2_conditionLT(1, 1), 0);
	ASSERTU1(i2_conditionLT(1, I2_MAX), 1);
	ASSERTU1(i2_conditionLT(1, I2_MIN), 0);
	ASSERTU1(i2_conditionLT(I2_MAX, 0), 0);
	ASSERTU1(i2_conditionLT(I2_MAX, 1), 0);
	ASSERTU1(i2_conditionLT(I2_MAX, I2_MAX), 0);
	ASSERTU1(i2_conditionLT(I2_MAX, I2_MIN), 0);
	ASSERTU1(i2_conditionLT(I2_MIN, 0), 1);
	ASSERTU1(i2_conditionLT(I2_MIN, 1), 1);
	ASSERTU1(i2_conditionLT(I2_MIN, I2_MAX), 1);
	ASSERTU1(i2_conditionLT(I2_MIN, I2_MIN), 0);

	ASSERTU1(i2_conditionLTUnused(0, 0, 0), 0);
	ASSERTU1(i2_conditionLTUnused(0, 0, 1), 1);
	ASSERTU1(i2_conditionLTUnused(0, 0, I2_MAX), 1);
	ASSERTU1(i2_conditionLTUnused(0, 0, I2_MIN), 0);
	ASSERTU1(i2_conditionLTUnused(0, 1, 0), 0);
	ASSERTU1(i2_conditionLTUnused(0, 1, 1), 0);
	ASSERTU1(i2_conditionLTUnused(0, 1, I2_MAX), 1);
	ASSERTU1(i2_conditionLTUnused(0, 1, I2_MIN), 0);
	ASSERTU1(i2_conditionLTUnused(0, I2_MAX, 0), 0);
	ASSERTU1(i2_conditionLTUnused(0, I2_MAX, 1), 0);
	ASSERTU1(i2_conditionLTUnused(0, I2_MAX, I2_MAX), 0);
	ASSERTU1(i2_conditionLTUnused(0, I2_MAX, I2_MIN), 0);
	ASSERTU1(i2_conditionLTUnused(0, I2_MIN, 0), 1);
	ASSERTU1(i2_conditionLTUnused(0, I2_MIN, 1), 1);
	ASSERTU1(i2_conditionLTUnused(0, I2_MIN, I2_MAX), 1);
	ASSERTU1(i2_conditionLTUnused(0, I2_MIN, I2_MIN), 0);

	ASSERTU1(i2_conditionLTZero(0), 0);
	ASSERTU1(i2_conditionLTZero(1), 0);
	ASSERTU1(i2_conditionLTZero(I2_MAX), 0);
	ASSERTU1(i2_conditionLTZero(I2_MIN), 1);

	ASSERTU1(i2_conditionLTOne(0), 1);
	ASSERTU1(i2_conditionLTOne(1), 0);
	ASSERTU1(i2_conditionLTOne(I2_MAX), 0);
	ASSERTU1(i2_conditionLTOne(I2_MIN), 1);
}


TEST i2_conditionNE_Main()
{
	extern u1 i2_conditionNE(i2 lhs, i2 rhs);
	extern u1 i2_conditionNEUnused(i2 val, i2 lhs, i2 rhs);
	extern u1 i2_conditionNEZero(i2 val);
	extern u1 i2_conditionNEOne(i2 val);

	ASSERTU1(i2_conditionNE(0, 0), 0);
	ASSERTU1(i2_conditionNE(0, 1), 1);
	ASSERTU1(i2_conditionNE(0, I2_MAX), 1);
	ASSERTU1(i2_conditionNE(0, I2_MIN), 1);
	ASSERTU1(i2_conditionNE(1, 0), 1);
	ASSERTU1(i2_conditionNE(1, 1), 0);
	ASSERTU1(i2_conditionNE(1, I2_MAX), 1);
	ASSERTU1(i2_conditionNE(1, I2_MIN), 1);
	ASSERTU1(i2_conditionNE(I2_MAX, 0), 1);
	ASSERTU1(i2_conditionNE(I2_MAX, 1), 1);
	ASSERTU1(i2_conditionNE(I2_MAX, I2_MAX), 0);
	ASSERTU1(i2_conditionNE(I2_MAX, I2_MIN), 1);
	ASSERTU1(i2_conditionNE(I2_MIN, 0), 1);
	ASSERTU1(i2_conditionNE(I2_MIN, 1), 1);
	ASSERTU1(i2_conditionNE(I2_MIN, I2_MAX), 1);
	ASSERTU1(i2_conditionNE(I2_MIN, I2_MIN), 0);

	ASSERTU1(i2_conditionNEUnused(0, 0, 0), 0);
	ASSERTU1(i2_conditionNEUnused(0, 0, 1), 1);
	ASSERTU1(i2_conditionNEUnused(0, 0, I2_MAX), 1);
	ASSERTU1(i2_conditionNEUnused(0, 0, I2_MIN), 1);
	ASSERTU1(i2_conditionNEUnused(0, 1, 0), 1);
	ASSERTU1(i2_conditionNEUnused(0, 1, 1), 0);
	ASSERTU1(i2_conditionNEUnused(0, 1, I2_MAX), 1);
	ASSERTU1(i2_conditionNEUnused(0, 1, I2_MIN), 1);
	ASSERTU1(i2_conditionNEUnused(0, I2_MAX, 0), 1);
	ASSERTU1(i2_conditionNEUnused(0, I2_MAX, 1), 1);
	ASSERTU1(i2_conditionNEUnused(0, I2_MAX, I2_MAX), 0);
	ASSERTU1(i2_conditionNEUnused(0, I2_MAX, I2_MIN), 1);
	ASSERTU1(i2_conditionNEUnused(0, I2_MIN, 0), 1);
	ASSERTU1(i2_conditionNEUnused(0, I2_MIN, 1), 1);
	ASSERTU1(i2_conditionNEUnused(0, I2_MIN, I2_MAX), 1);
	ASSERTU1(i2_conditionNEUnused(0, I2_MIN, I2_MIN), 0);

	ASSERTU1(i2_conditionNEZero(0), 0);
	ASSERTU1(i2_conditionNEZero(1), 1);
	ASSERTU1(i2_conditionNEZero(I2_MAX), 1);
	ASSERTU1(i2_conditionNEZero(I2_MIN), 1);

	ASSERTU1(i2_conditionNEOne(0), 1);
	ASSERTU1(i2_conditionNEOne(1), 0);
	ASSERTU1(i2_conditionNEOne(I2_MAX), 1);
	ASSERTU1(i2_conditionNEOne(I2_MIN), 1);
}


TEST u2_minimum_Main()
{
	extern u2 u2_minimumNew(u2 lhs, u2 rhs);
	extern u2 u2_minimum(u2 lhs, u2 rhs);

	ASSERTU2(u2_minimumNew(0, 0), 0);
	ASSERTU2(u2_minimum(0, 0), 0);
	ASSERTU2(u2_minimumNew(0, 1), 0);
	ASSERTU2(u2_minimum(0, 1), 0);
	ASSERTU2(u2_minimumNew(0, U2_MAX), 0);
	ASSERTU2(u2_minimum(0, U2_MAX), 0);
	ASSERTU2(u2_minimumNew(1, 0), 0);
	ASSERTU2(u2_minimum(1, 0), 0);
	ASSERTU2(u2_minimumNew(1, 1), 1);
	ASSERTU2(u2_minimum(1, 1), 1);
	ASSERTU2(u2_minimumNew(1, U2_MAX), 1);
	ASSERTU2(u2_minimum(1, U2_MAX), 1);
	ASSERTU2(u2_minimumNew(U2_MAX, 0), 0);
	ASSERTU2(u2_minimum(U2_MAX, 0), 0);
	ASSERTU2(u2_minimumNew(U2_MAX, 1), 1);
	ASSERTU2(u2_minimum(U2_MAX, 1), 1);
	ASSERTU2(u2_minimumNew(U2_MAX, U2_MAX), U2_MAX);
	ASSERTU2(u2_minimum(U2_MAX, U2_MAX), U2_MAX);
}


TEST u2_maximum_Main()
{
	extern u2 u2_maximumNew(u2 lhs, u2 rhs);
	extern u2 u2_maximum(u2 lhs, u2 rhs);

	ASSERTU2(u2_maximumNew(0, 0), 0);
	ASSERTU2(u2_maximum(0, 0), 0);
	ASSERTU2(u2_maximumNew(0, 1), 1);
	ASSERTU2(u2_maximum(0, 1), 1);
	ASSERTU2(u2_maximumNew(0, U2_MAX), U2_MAX);
	ASSERTU2(u2_maximum(0, U2_MAX), U2_MAX);
	ASSERTU2(u2_maximumNew(1, 0), 1);
	ASSERTU2(u2_maximum(1, 0), 1);
	ASSERTU2(u2_maximumNew(1, 1), 1);
	ASSERTU2(u2_maximum(1, 1), 1);
	ASSERTU2(u2_maximumNew(1, U2_MAX), U2_MAX);
	ASSERTU2(u2_maximum(1, U2_MAX), U2_MAX);
	ASSERTU2(u2_maximumNew(U2_MAX, 0), U2_MAX);
	ASSERTU2(u2_maximum(U2_MAX, 0), U2_MAX);
	ASSERTU2(u2_maximumNew(U2_MAX, 1), U2_MAX);
	ASSERTU2(u2_maximum(U2_MAX, 1), U2_MAX);
	ASSERTU2(u2_maximumNew(U2_MAX, U2_MAX), U2_MAX);
	ASSERTU2(u2_maximum(U2_MAX, U2_MAX), U2_MAX);
}


TEST i2_minimum_Main()
{
	extern i2 i2_minimumNew(i2 lhs, i2 rhs);
	extern i2 i2_minimum(i2 lhs, i2 rhs);

	ASSERTI2(i2_minimumNew(0, 0), 0);
	ASSERTI2(i2_minimum(0, 0), 0);
	ASSERTI2(i2_minimumNew(0, 1), 0);
	ASSERTI2(i2_minimum(0, 1), 0);
	ASSERTI2(i2_minimumNew(0, -1), -1);
	ASSERTI2(i2_minimum(0, -1), -1);
	ASSERTI2(i2_minimumNew(0, I2_MAX), 0);
	ASSERTI2(i2_minimum(0, I2_MAX), 0);
	ASSERTI2(i2_minimumNew(0, I2_MIN), I2_MIN);
	ASSERTI2(i2_minimum(0, I2_MIN), I2_MIN);
	ASSERTI2(i2_minimumNew(1, 0), 0);
	ASSERTI2(i2_minimum(1, 0), 0);
	ASSERTI2(i2_minimumNew(1, 1), 1);
	ASSERTI2(i2_minimum(1, 1), 1);
	ASSERTI2(i2_minimumNew(1, -1), -1);
	ASSERTI2(i2_minimum(1, -1), -1);
	ASSERTI2(i2_minimumNew(1, I2_MAX), 1);
	ASSERTI2(i2_minimum(1, I2_MAX), 1);
	ASSERTI2(i2_minimumNew(1, I2_MIN), I2_MIN);
	ASSERTI2(i2_minimum(1, I2_MIN), I2_MIN);
	ASSERTI2(i2_minimumNew(I2_MAX, 0), 0);
	ASSERTI2(i2_minimum(I2_MAX, 0), 0);
	ASSERTI2(i2_minimumNew(I2_MAX, 1), 1);
	ASSERTI2(i2_minimum(I2_MAX, 1), 1);
	ASSERTI2(i2_minimumNew(I2_MAX, -1), -1);
	ASSERTI2(i2_minimum(I2_MAX, -1), -1);
	ASSERTI2(i2_minimumNew(I2_MAX, I2_MAX), I2_MAX);
	ASSERTI2(i2_minimum(I2_MAX, I2_MAX), I2_MAX);
	ASSERTI2(i2_minimumNew(I2_MAX, I2_MIN), I2_MIN);
	ASSERTI2(i2_minimum(I2_MAX, I2_MIN), I2_MIN);
	ASSERTI2(i2_minimumNew(I2_MIN, 0), I2_MIN);
	ASSERTI2(i2_minimum(I2_MIN, 0), I2_MIN);
	ASSERTI2(i2_minimumNew(I2_MIN, 1), I2_MIN);
	ASSERTI2(i2_minimum(I2_MIN, 1), I2_MIN);
	ASSERTI2(i2_minimumNew(I2_MIN, -1), I2_MIN);
	ASSERTI2(i2_minimum(I2_MIN, -1), I2_MIN);
	ASSERTI2(i2_minimumNew(I2_MIN, I2_MAX), I2_MIN);
	ASSERTI2(i2_minimum(I2_MIN, I2_MAX), I2_MIN);
	ASSERTI2(i2_minimumNew(I2_MIN, I2_MIN), I2_MIN);
	ASSERTI2(i2_minimum(I2_MIN, I2_MIN), I2_MIN);
}


TEST i2_maximum_Main()
{
	extern i2 i2_maximumNew(i2 lhs, i2 rhs);
	extern i2 i2_maximum(i2 lhs, i2 rhs);

	ASSERTI2(i2_maximumNew(0, 0), 0);
	ASSERTI2(i2_maximum(0, 0), 0);
	ASSERTI2(i2_maximumNew(0, 1), 1);
	ASSERTI2(i2_maximum(0, 1), 1);
	ASSERTI2(i2_maximumNew(0, -1), 0);
	ASSERTI2(i2_maximum(0, -1), 0);
	ASSERTI2(i2_maximumNew(0, I2_MAX), I2_MAX);
	ASSERTI2(i2_maximum(0, I2_MAX), I2_MAX);
	ASSERTI2(i2_maximumNew(0, I2_MIN), 0);
	ASSERTI2(i2_maximum(0, I2_MIN), 0);
	ASSERTI2(i2_maximumNew(1, 0), 1);
	ASSERTI2(i2_maximum(1, 0), 1);
	ASSERTI2(i2_maximumNew(1, 1), 1);
	ASSERTI2(i2_maximum(1, 1), 1);
	ASSERTI2(i2_maximumNew(1, -1), 1);
	ASSERTI2(i2_maximum(1, -1), 1);
	ASSERTI2(i2_maximumNew(1, I2_MAX), I2_MAX);
	ASSERTI2(i2_maximum(1, I2_MAX), I2_MAX);
	ASSERTI2(i2_maximumNew(1, I2_MIN), 1);
	ASSERTI2(i2_maximum(1, I2_MIN), 1);
	ASSERTI2(i2_maximumNew(I2_MAX, 0), I2_MAX);
	ASSERTI2(i2_maximum(I2_MAX, 0), I2_MAX);
	ASSERTI2(i2_maximumNew(I2_MAX, 1), I2_MAX);
	ASSERTI2(i2_maximum(I2_MAX, 1), I2_MAX);
	ASSERTI2(i2_maximumNew(I2_MAX, -1), I2_MAX);
	ASSERTI2(i2_maximum(I2_MAX, -1), I2_MAX);
	ASSERTI2(i2_maximumNew(I2_MAX, I2_MAX), I2_MAX);
	ASSERTI2(i2_maximum(I2_MAX, I2_MAX), I2_MAX);
	ASSERTI2(i2_maximumNew(I2_MAX, I2_MIN), I2_MAX);
	ASSERTI2(i2_maximum(I2_MAX, I2_MIN), I2_MAX);
	ASSERTI2(i2_maximumNew(I2_MIN, 0), 0);
	ASSERTI2(i2_maximum(I2_MIN, 0), 0);
	ASSERTI2(i2_maximumNew(I2_MIN, 1), 1);
	ASSERTI2(i2_maximum(I2_MIN, 1), 1);
	ASSERTI2(i2_maximumNew(I2_MIN, -1), -1);
	ASSERTI2(i2_maximum(I2_MIN, -1), -1);
	ASSERTI2(i2_maximumNew(I2_MIN, I2_MAX), I2_MAX);
	ASSERTI2(i2_maximum(I2_MIN, I2_MAX), I2_MAX);
	ASSERTI2(i2_maximumNew(I2_MIN, I2_MIN), I2_MIN);
	ASSERTI2(i2_maximum(I2_MIN, I2_MIN), I2_MIN);
}


