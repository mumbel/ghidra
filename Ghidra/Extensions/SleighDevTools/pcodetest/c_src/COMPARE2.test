	ASSERTU1(i2_conditionEQ(I2_MAX, 1), 0);
	ASSERTU1(i2_conditionEQ(I2_MAX, I2_MAX), 1);
	ASSERTU1(i2_conditionEQ(I2_MAX, I2_MIN), 0);
	ASSERTU1(i2_conditionEQ(I2_MIN, 0), 0);
	ASSERTU1(i2_conditionEQ(I2_MIN, 1), 0);
	ASSERTU1(i2_conditionEQ(I2_MIN, I2_MAX), 0);
	ASSERTU1(i2_conditionEQ(I2_MIN, I2_MIN), 1);

	ASSERTU1(i2_conditionEQUnused(0, 0, 0), 1);
	ASSERTU1(i2_conditionEQUnused(0, 0, 1), 0);
	ASSERTU1(i2_conditionEQUnused(0, 0, I2_MAX), 0);
	ASSERTU1(i2_conditionEQUnused(0, 0, I2_MIN), 0);
	ASSERTU1(i2_conditionEQUnused(0, 1, 0), 0);
	ASSERTU1(i2_conditionEQUnused(0, 1, 1), 1);
	ASSERTU1(i2_conditionEQUnused(0, 1, I2_MAX), 0);
	ASSERTU1(i2_conditionEQUnused(0, 1, I2_MIN), 0);
	ASSERTU1(i2_conditionEQUnused(0, I2_MAX, 0), 0);
	ASSERTU1(i2_conditionEQUnused(0, I2_MAX, 1), 0);
	ASSERTU1(i2_conditionEQUnused(0, I2_MAX, I2_MAX), 1);
	ASSERTU1(i2_conditionEQUnused(0, I2_MAX, I2_MIN), 0);
	ASSERTU1(i2_conditionEQUnused(0, I2_MIN, 0), 0);
	ASSERTU1(i2_conditionEQUnused(0, I2_MIN, 1), 0);
	ASSERTU1(i2_conditionEQUnused(0, I2_MIN, I2_MAX), 0);
	ASSERTU1(i2_conditionEQUnused(0, I2_MIN, I2_MIN), 1);

	ASSERTU1(i2_conditionEQZero(0), 1);
