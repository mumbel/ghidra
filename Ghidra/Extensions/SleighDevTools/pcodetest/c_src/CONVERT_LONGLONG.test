TEST pcode_i8_to_i1_convert_Main()
{
	extern i1 pcode_i8_to_i1_convert(i8 a);
	extern i1 pcode_i8_to_i1_convertUnused(i8 val, i8 a);
	
	ASSERTI1(pcode_i8_to_i1_convert(0), 0);
	ASSERTI1(pcode_i8_to_i1_convert(1), 1);
	ASSERTI1(pcode_i8_to_i1_convert(-1), -1);
	ASSERTI1(pcode_i8_to_i1_convert(I1_MAX), I1_MAX);
	ASSERTI1(pcode_i8_to_i1_convert(I1_MIN), I1_MIN);
	ASSERTI1(pcode_i8_to_i1_convert(I8_MAX), -1);
	ASSERTI1(pcode_i8_to_i1_convert(I8_MIN), 0);

	ASSERTI1(pcode_i8_to_i1_convertUnused(0, 0), 0);
	ASSERTI1(pcode_i8_to_i1_convertUnused(0, 1), 1);
	ASSERTI1(pcode_i8_to_i1_convertUnused(0, -1), -1);
	ASSERTI1(pcode_i8_to_i1_convertUnused(0, I1_MAX), I1_MAX);
	ASSERTI1(pcode_i8_to_i1_convertUnused(0, I1_MIN), I1_MIN);
	ASSERTI1(pcode_i8_to_i1_convertUnused(0, I8_MAX), -1);
	ASSERTI1(pcode_i8_to_i1_convertUnused(0, I8_MIN), 0);
}

