	ASSERTI8(pcode_u8_to_i8_convertUnused(0, 1), 1);
	ASSERTI8(pcode_u8_to_i8_convertUnused(0, I8_MAX), I8_MAX);
	ASSERTI8(pcode_u8_to_i8_convertUnused(0, U8_MAX), -1);
}

